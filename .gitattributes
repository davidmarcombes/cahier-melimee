# Enforce LF line endings for all text files in the repo.
# This prevents CRLF/LF hash mismatches when devs work across Windows and Linux.
* text=auto eol=lf

# Explicitly mark common text types (overrides auto-detection for edge cases)
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.njk  text eol=lf
*.html text eol=lf
*.csv  text eol=lf
*.txt  text eol=lf

# Binary files — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.svg  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ico  binary
