<header class="border-b bg-surface-chrome" x-data="{ mobileOpen: false, testOpen: false }">
  <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="{{ '/fr' | url }}" class="flex items-center gap-2 shrink-0">
      {% image "src/assets/images/logo.png", site.title + " logo", "2rem", "h-8 w-auto", "eager" %}
      <span class="font-semibold text-sm sm:text-base">{{ site.title }}</span>
    </a>

    {# Desktop nav #}
    <nav class="hidden md:flex items-center gap-4">
      {% for item in navigation[lang or 'fr'] %}
        <a href="{{ item.url | url }}"
           {% if page.url == item.url %}aria-current="page"{% endif %}
           class="text-sm hover:text-primary-500 transition-colors">{{ item.text }}</a>
      {% endfor %}
      {% if site.testEnabled and isSeriesPage %}
      {# Test dropdown #}
      <div class="relative" @click.outside="testOpen = false">
        <button @click="testOpen = !testOpen"
                class="text-sm text-amber-600 dark:text-amber-400 hover:text-amber-800 dark:hover:text-amber-200 transition-colors"
                :aria-expanded="testOpen">Test</button>
        <div x-show="testOpen" x-cloak x-transition
             class="absolute right-0 mt-2 w-52 bg-surface-chrome border border-slate-200 dark:border-slate-700 rounded-xl shadow-lg py-1 z-50">
          <button @click="window.dispatchEvent(new Event('test:validate')); testOpen = false"
                  class="block w-full text-left px-4 py-2 text-sm hover:bg-surface-subtle transition-colors">
            Valider la série
          </button>
          <button @click="window.dispatchEvent(new Event('test:report')); testOpen = false"
                  class="block w-full text-left px-4 py-2 text-sm hover:bg-surface-subtle transition-colors">
            Signaler un problème
          </button>
        </div>
      </div>
      {% endif %}
      {% include "components/theme-toggle.njk" %}
    </nav>

    {# Mobile: theme toggle + hamburger #}
    <div class="flex items-center gap-1 md:hidden">
      {% include "components/theme-toggle.njk" %}
      <button
        @click="mobileOpen = !mobileOpen"
        class="p-2 rounded-lg text-content-subtle hover:text-content-default hover:bg-surface-subtle transition-colors"
        :aria-label="mobileOpen ? 'Fermer le menu' : 'Ouvrir le menu'"
        :aria-expanded="mobileOpen"
      >
        <svg x-show="!mobileOpen" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
        </svg>
        <svg x-show="mobileOpen" x-cloak xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </button>
    </div>
  </div>

  {# Mobile dropdown #}
  <nav
    x-show="mobileOpen"
    x-cloak
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-2"
    class="md:hidden border-t border-slate-200 dark:border-slate-700 bg-surface-chrome px-4 py-3"
  >
    {% for item in navigation[lang or 'fr'] %}
      <a href="{{ item.url | url }}"
         {% if page.url == item.url %}aria-current="page"{% endif %}
         @click="mobileOpen = false"
         class="block py-3 text-sm text-content-default hover:text-primary-500 transition-colors">{{ item.text }}</a>
    {% endfor %}
    {% if site.testEnabled and isSeriesPage %}
    <div class="border-t border-slate-200 dark:border-slate-700 mt-2 pt-2">
      <span class="block py-2 text-xs font-semibold text-amber-600 dark:text-amber-400 uppercase tracking-wide">Test</span>
      <button @click="window.dispatchEvent(new Event('test:validate')); mobileOpen = false"
              class="block w-full text-left py-2 text-sm text-content-default hover:text-primary-500 transition-colors">
        Valider la série
      </button>
      <button @click="window.dispatchEvent(new Event('test:report')); mobileOpen = false"
              class="block w-full text-left py-2 text-sm text-content-default hover:text-primary-500 transition-colors">
        Signaler un problème
      </button>
    </div>
    {% endif %}
  </nav>


</header>
