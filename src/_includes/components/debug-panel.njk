{#
  Debug panel — right-click anywhere on a series page to open.
  Builds an agent-ready prompt from the current exercise state and copies it to clipboard.
  No dependency on testEnabled / PocketBase — always present on series pages.
#}
<div x-data="debugPanel()" x-init="init()" x-cloak>

  {# Backdrop + panel #}
  <div
    x-show="open"
    x-transition:enter="transition ease-out duration-150"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-100"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 z-[90] flex items-end justify-end p-4 pointer-events-none"
    @keydown.escape.window="open = false"
  >
    {# Transparent backdrop to close on click outside #}
    <div class="absolute inset-0 pointer-events-auto" @click="open = false"></div>

    {# Panel #}
    <div
      x-show="open"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 translate-y-4 scale-95"
      x-transition:enter-end="opacity-100 translate-y-0 scale-100"
      class="relative w-full max-w-lg bg-surface-chrome border border-slate-200 dark:border-slate-700 rounded-2xl shadow-2xl p-5 space-y-4 pointer-events-auto"
      @click.stop
    >
      {# Header #}
      <div class="flex items-center justify-between">
        <div>
          <h2 class="font-bold text-content-default text-base">Debug — Agent Prompt</h2>
          <p class="text-xs text-content-subtle mt-0.5" x-text="panelSubtitle"></p>
        </div>
        <button type="button" @click="open = false"
                class="text-content-subtle hover:text-content-default text-xl leading-none transition-colors"
                aria-label="Fermer">&times;</button>
      </div>

      {# Problem note #}
      <div>
        <label class="block text-xs font-semibold text-content-subtle mb-1 uppercase tracking-wide">Problème observé</label>
        <textarea
          x-model="note"
          placeholder="Décris ce qui ne va pas…"
          rows="2"
          class="w-full px-3 py-2 text-sm border rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 resize-none
                 bg-surface-subtle text-content-default border-slate-200 dark:border-slate-700"
        ></textarea>
      </div>

      {# Agent prompt preview #}
      <div>
        <label class="block text-xs font-semibold text-content-subtle mb-1 uppercase tracking-wide">Prompt agent (lecture seule)</label>
        <pre class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700
                    text-content-subtle overflow-auto max-h-48 whitespace-pre-wrap break-words"
             x-text="prompt"></pre>
      </div>

      {# Actions #}
      <div class="flex items-center gap-2">
        <button type="button" @click="copy()"
                class="px-4 py-2 text-sm font-bold rounded-xl transition-all active:scale-95
                       bg-primary-500 text-white hover:bg-primary-600 shadow-sm">
          <span x-show="!copied">Copier le prompt</span>
          <span x-show="copied">Copié !</span>
        </button>
        <button type="button" @click="open = false"
                class="ml-auto px-3 py-2 text-sm text-content-subtle hover:text-content-default transition-colors">
          Fermer
        </button>
      </div>
    </div>
  </div>
</div>
