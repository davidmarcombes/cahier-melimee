{# Graduated ruler visual #}
<div x-show="cur.type === 'ruler'" class="bg-surface-subtle rounded-2xl shadow-lg border border-slate-200 dark:border-slate-700 p-6 mb-8">
  <div class="prose dark:prose-invert text-center text-sm max-w-none mb-4 text-content-subtle"
       x-show="cur.body" x-html="cur.body"></div>
  {# A ruler in hundredths (100 ticks a unit or more) keeps 640 px and scrolls sideways on a phone (below sm only: a wider screen has room),
     opened on the marker #}
  <div class="overflow-x-auto -mx-2 px-2" x-effect="cur.ruler && $nextTick(() => { const m = $el.querySelector('polygon'); if (m && $el.scrollWidth > $el.clientWidth) $el.scrollLeft = m.getBoundingClientRect().left - $el.getBoundingClientRect().left + $el.scrollLeft - $el.clientWidth / 2; })">
    <svg viewBox="0 0 500 90" class="w-full text-content-default" :class="cur.ruler && (cur.ruler.divisions || 1) * (cur.ruler.subdivisions || 1) * (cur.ruler.max - cur.ruler.min) >= 100 ? 'min-w-[640px] sm:min-w-0' : ''" x-html="rulerSvg"></svg>
  </div>
</div>
