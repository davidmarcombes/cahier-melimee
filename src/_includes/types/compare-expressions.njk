{# Compare-expressions — same cycling button (< = >) as compare, but left/right are expression strings #}
<div x-show="cur.type === 'compare-expressions'" class="space-y-3">
  <p class="text-center text-sm text-content-subtle mb-1">Sans calculer, clique sur <strong>?</strong> pour choisir &lt; &gt; ou =</p>
  <div x-show="cur.body" x-html="cur.body" class="prose dark:prose-invert text-sm text-center mb-4 max-w-none text-content-subtle"></div>

  <template x-for="(c, i) in cur.comparisons" :key="i">
    <div
      class="flex items-center gap-2 py-3 px-4 rounded-xl border transition-colors"
      :class="{
        'border-red-300 dark:border-red-700 bg-red-50 dark:bg-red-900/20': cmpErrors.includes(i),
        'border-green-300 dark:border-green-700 bg-green-50 dark:bg-green-900/20': solved,
        'border-slate-200 dark:border-slate-700 bg-surface-subtle': !cmpErrors.includes(i) && !solved
      }"
    >
      <span class="text-base font-mono text-content-default flex-1 text-right leading-tight" x-text="c.left"></span>

      <button
        type="button"
        @click="if(!solved){ cmpInputs[i] = cmpInputs[i]==='>' ? '<' : cmpInputs[i]==='<' ? '=' : '>'; cmpErrors=cmpErrors.filter(e=>e!==i) }"
        :disabled="solved"
        class="w-12 h-12 rounded-xl border-2 text-xl font-bold transition-all active:scale-90 shrink-0 inline-flex items-center justify-center select-none"
        :class="solved
          ? 'border-green-500 bg-green-500 text-white cursor-default'
          : cmpErrors.includes(i)
            ? 'border-red-400 bg-red-50 dark:bg-red-900/20 text-red-500 dark:text-red-400'
            : cmpInputs[i]
              ? 'border-primary-500 bg-primary-500 text-white cursor-pointer'
              : 'border-slate-300 dark:border-slate-600 text-content-subtle cursor-pointer hover:border-primary-400 hover:text-content-default'"
        x-text="cmpInputs[i] || '?'"
      ></button>

      <span class="text-base font-mono text-content-default flex-1 text-left leading-tight" x-text="c.right"></span>
    </div>
  </template>

  {# Verify button #}
  <div x-show="!solved" class="flex justify-center pt-2">
    <button
      type="button"
      @click="check()"
      :disabled="cmpInputs.some(v => v === null)"
      class="px-6 py-2 text-sm font-bold rounded-xl bg-primary-500 text-white hover:bg-primary-600 transition-all active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed"
    >
      Vérifier
    </button>
  </div>
</div>
