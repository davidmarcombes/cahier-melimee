{# Count objects — scattered emoji SVG, type the number (maternelle: tap one of 3 numbers) #}
<div x-show="cur.type === 'count-objects'" class="space-y-6">

  {# Scattered SVG — with `flash`, hidden after a short look; 👀 shows it again #}
  <div class="flex justify-center">
    <div class="relative rounded-2xl border-2 border-slate-200 dark:border-slate-700 bg-surface-subtle overflow-hidden">
      <div x-html="cur.svgHtml" :class="countHidden && 'invisible'"></div>
      <button type="button" x-show="countHidden" @click="countShow()" aria-label="Revoir"
        class="absolute inset-0 flex items-center justify-center text-6xl hover:bg-primary-50 dark:hover:bg-primary-900/20 transition-colors">👀</button>
    </div>
  </div>

  {% if level === 'GS' %}
  {# Number buttons — no typing at maternelle #}
  <div class="flex justify-center gap-4">
    <template x-for="n in countChoices" :key="n">
      <button type="button" @click="countTap(n)" :disabled="solved"
        class="w-20 h-20 text-4xl font-extrabold rounded-2xl border-2 transition-all active:scale-95"
        :class="{ 'border-green-500 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300': solved && String(n) === cur.answers[0], 'border-red-400 bg-red-50 dark:bg-red-900/20 text-red-500 animate-shake': countWrong === n, 'opacity-30': solved && String(n) !== cur.answers[0], 'border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-content-default hover:border-primary-400 hover:bg-primary-50 dark:hover:bg-primary-900/20': !solved && countWrong !== n }"
        x-text="n"></button>
    </template>
  </div>
  {% else %}
  {# Question #}
  <p class="text-center text-lg font-medium text-content-default" x-html="cur.title"></p>

  {# Number input + verify button #}
  <div class="flex items-center justify-center gap-3">
    <input
      type="text"
      inputmode="numeric"
      x-model="userInput"
      @keydown.enter="check()"
      :disabled="solved"
      placeholder="?"
      aria-label="Combien ?"
      :style="{ width: 'calc(' + Math.max(2, String(cur.answer ?? '').length) + 'ch + 3rem)' }"
      class="px-4 py-4 text-3xl font-extrabold text-center border-2 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary-500 transition-colors bg-surface-subtle text-content-default"
      :class="{
        'border-green-500 bg-green-50 dark:bg-green-900/20': solved,
        'border-red-400 bg-red-50 dark:bg-red-900/20': showError,
        'border-primary-300 dark:border-primary-600': !solved && !showError
      }"
    />
    <button
      type="button"
      @click="check()"
      :disabled="solved || !userInput.trim()"
      class="shrink-0 px-6 py-4 text-lg font-bold rounded-2xl transition-all active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed"
      :class="solved ? 'bg-green-500 text-white' : 'bg-primary-500 text-white hover:bg-primary-600 shadow-md'"
    >
      <span x-show="!solved">Vérifier</span>
      <span x-show="solved">Bravo !</span>
    </button>
  </div>
  {% endif %}

</div>
