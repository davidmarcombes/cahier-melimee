{# Think Board — 4-quadrant multimodal representation of one math fact #}
{# Quadrants: Histoire (story), Dessin (drawing), Manipulation (dot array), Symbole (equation) #}
<div x-show="cur.type === 'think-board'" class="space-y-3">

  {# ── 2×2 grid ── #}
  <div class="grid grid-cols-2 gap-3">

    {# Q1 — Histoire #}
    <div class="flex flex-col gap-2 p-3 rounded-2xl border-2 bg-yellow-50 dark:bg-yellow-900/10 border-yellow-300 dark:border-yellow-700">
      <p class="text-xs font-bold text-yellow-700 dark:text-yellow-400 uppercase tracking-wide">Histoire</p>
      <textarea
        x-model="tbStory"
        :disabled="solved"
        rows="3"
        placeholder="Écris une histoire pour ce calcul…"
        class="w-full text-sm px-2 py-1.5 rounded-lg border border-yellow-300 dark:border-yellow-700 bg-white dark:bg-slate-800 text-content-default focus:outline-none focus:ring-2 focus:ring-yellow-400 resize-none"
        :class="{'border-green-500': solved, 'border-red-400': tbStoryError && !solved}"
      ></textarea>
      <template x-if="cur.tbStoryHint && !solved">
        <p class="text-xs italic text-yellow-600 dark:text-yellow-500" x-text="cur.tbStoryHint"></p>
      </template>
    </div>

    {# Q2 — Dessin #}
    <div class="flex flex-col gap-2 p-3 rounded-2xl border-2 bg-green-50 dark:bg-green-900/10 border-green-300 dark:border-green-700">
      <div class="flex items-center justify-between">
        <p class="text-xs font-bold text-green-700 dark:text-green-400 uppercase tracking-wide">Dessin</p>
        <button type="button" @click="tbClearCanvas()" class="text-xs text-green-600 dark:text-green-500 hover:underline">Effacer</button>
      </div>
      <canvas
        x-ref="tbCanvas"
        width="160" height="100"
        class="w-full rounded-lg bg-white dark:bg-slate-800 border border-green-300 dark:border-green-700 touch-none cursor-crosshair"
        @pointerdown="tbDrawStart($event)"
        @pointermove="tbDrawMove($event)"
        @pointerup="tbDrawEnd()"
        @pointerleave="tbDrawEnd()"
      ></canvas>
    </div>

    {# Q3 — Manipulation (dot array) #}
    <div class="flex flex-col gap-2 p-3 rounded-2xl border-2 bg-blue-50 dark:bg-blue-900/10 border-blue-300 dark:border-blue-700">
      <p class="text-xs font-bold text-blue-700 dark:text-blue-400 uppercase tracking-wide">Manipulation</p>
      <div class="flex flex-wrap gap-1 justify-center items-center py-1 min-h-[60px]">
        <template x-for="(group, gi) in tbDotGroups" :key="gi">
          <div class="flex flex-wrap gap-0.5 p-1 rounded border border-blue-200 dark:border-blue-700">
            <template x-for="(_, di) in Array.from({length: group})" :key="di">
              <div class="w-3 h-3 rounded-full bg-blue-500 dark:bg-blue-400"></div>
            </template>
          </div>
        </template>
      </div>
      <p class="text-xs text-center text-blue-600 dark:text-blue-400" x-text="cur.tbManipLabel || ''"></p>
    </div>

    {# Q4 — Symbole #}
    <div class="flex flex-col gap-2 p-3 rounded-2xl border-2 bg-purple-50 dark:bg-purple-900/10 border-purple-300 dark:border-purple-700">
      <p class="text-xs font-bold text-purple-700 dark:text-purple-400 uppercase tracking-wide">Symbole</p>
      <div class="flex items-center gap-2 justify-center flex-wrap">
        <span class="text-xl font-bold text-content-default" x-text="cur.tbExpression"></span>
        <span class="text-xl font-bold text-content-subtle">=</span>
        <input
          type="text"
          inputmode="numeric"
          x-ref="input"
          x-model="userInput"
          @keydown.enter="check()"
          :disabled="solved"
          placeholder="?"
          class="w-20 px-3 py-2 text-xl font-bold text-center border-2 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 transition-colors bg-white dark:bg-slate-800 text-content-default"
          :class="{
            'border-green-500 bg-green-50 dark:bg-green-900/20': solved,
            'border-red-400 bg-red-50 dark:bg-red-900/20': showError && !solved,
            'border-purple-300 dark:border-purple-600': !solved && !showError
          }"
        />
      </div>
      <template x-if="cur.tbUnit">
        <p class="text-xs text-center text-purple-600 dark:text-purple-400" x-text="cur.tbUnit"></p>
      </template>
    </div>

  </div>{# end grid #}

  {# ── Verify button ── #}
  <div x-show="!solved" class="flex justify-center pt-1">
    <button
      type="button"
      @click="check()"
      :disabled="!userInput.trim()"
      class="px-6 py-2 text-sm font-bold rounded-xl bg-primary-500 text-white hover:bg-primary-600 transition-all active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed"
    >Vérifier</button>
  </div>

</div>
