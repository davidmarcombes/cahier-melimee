{# Number Hunt — click numbers 1 to N in order; emoji waits in the center #}
<div x-show="cur.type === 'number-hunt'" class="space-y-4">

  {# Grid #}
  <div class="overflow-x-auto">
    <div class="grid gap-1 mx-auto p-2"
         style="max-width:420px"
         :style="`grid-template-columns: repeat(${cur.cols}, minmax(0, 1fr))`">
      <template x-for="(v, i) in (cur.grid || [])" :key="i">
        <div
          class="aspect-square flex items-center justify-center font-bold rounded transition-all duration-100 select-none"
          :class="{
            'invisible pointer-events-none': v === 0,
            'text-3xl border-2 border-amber-300 dark:border-amber-600 bg-amber-50 dark:bg-amber-900/20 cursor-default shadow-inner':
              v === -1,
            'text-xs sm:text-sm border-2 border-green-400 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 scale-90 cursor-default':
              v > 0 && huntClicked.includes(i),
            'text-xs sm:text-sm border-2 border-red-400 bg-red-50 dark:bg-red-900/20 text-red-500 animate-bounce':
              v > 0 && huntError === i,
            'text-xs sm:text-sm border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-content-default hover:border-primary-400 hover:bg-primary-50 dark:hover:bg-primary-900/20 active:scale-90 cursor-pointer':
              v > 0 && !huntClicked.includes(i) && huntError !== i
          }"
          @click="v > 0 && !huntClicked.includes(i) && !solved ? huntTap(i) : null"
          x-html="v === -1 ? cur.emoji : (v > 0 ? v : '')"
        ></div>
      </template>
    </div>
  </div>

  {# Progress hint #}
  <p class="text-center text-sm text-content-subtle" x-show="!solved">
    <span x-text="huntClicked.length"></span> / <span x-text="cur.count"></span>
    &nbsp;·&nbsp; prochain :
    <strong class="text-lg text-primary-600 dark:text-primary-400" x-text="huntNext"></strong>
  </p>

</div>
