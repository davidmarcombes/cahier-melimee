{# Inverse Problems — Base problem + its variations (Russie) #}
<div x-show="cur.type === 'inverse-problem'" class="space-y-6">
  <div class="bg-surface-subtle rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 p-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-xs font-bold uppercase tracking-wider text-content-subtle">Problème de base</h3>
      <span x-show="ipSolved[0]" class="text-green-500 font-bold flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
        Résolu
      </span>
    </div>
    <div class="prose dark:prose-invert mb-4 text-pretty" x-html="cur.ipBase.text"></div>
    <div x-show="!ipSolved[0]" class="flex items-center gap-2">
      <input
        type="text"
        x-model="ipInputs[0]"
        @keydown.enter="ipCheck(0)"
        placeholder="Réponse…"
        class="w-full px-4 py-2 border-2 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 text-content-default"
        :class="{ 'border-red-400': ipErrors.includes(0) }"
        x-ref="ipInput0"
      />
      <button type="button" @click="ipCheck(0)" class="shrink-0 px-5 py-2 bg-primary-500 text-white font-bold rounded-xl hover:bg-primary-600 transition-colors active:scale-95">
        Vérifier
      </button>
    </div>
  </div>

  <template x-if="ipSolved[0]">
    <div class="space-y-4">
      <h3 class="text-xs font-bold uppercase tracking-wider text-content-subtle text-center">Maintenant, résous les problèmes inverses :</h3>

      <template x-for="(inv, idx) in cur.ipInverses" :key="idx">
        <div
          class="p-5 rounded-2xl border-2 transition-all"
          :class="{
            'bg-green-50 dark:bg-green-900/10 border-green-200 dark:border-green-800': ipSolved[idx + 1],
            'bg-surface-subtle border-slate-200 dark:border-slate-700': !ipSolved[idx + 1]
          }"
        >
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1">
              <div class="prose dark:prose-invert text-sm mb-3 text-pretty" x-html="inv.text"></div>
              <div x-show="!ipSolved[idx + 1]" class="flex items-center gap-2">
                <input
                  type="text"
                  x-model="ipInputs[idx + 1]"
                  @keydown.enter="ipCheck(idx + 1)"
                  placeholder="?"
                  class="w-24 px-3 py-2 text-center border-2 rounded-lg bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-600 text-content-default focus:outline-none focus:ring-2 focus:ring-primary-500"
                  :class="{ 'border-red-400': ipErrors.includes(idx + 1) }"
                  :x-ref="'ipInput' + (idx + 1)"
                />
                <button type="button" @click="ipCheck(idx + 1)" class="p-2 text-primary-500 hover:bg-primary-50 dark:hover:bg-primary-900/20 rounded-lg transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                </button>
              </div>
            </div>
            <div x-show="ipSolved[idx + 1]" class="shrink-0 text-green-500">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            </div>
          </div>
        </div>
      </template>
    </div>
  </template>
</div>
