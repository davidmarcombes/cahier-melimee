{# decimal-blocks — a ± b in a place-value table, each digit drawn as pieces (10 · 1 | 0,1 · 0,01 · 0,001).
   The pupil builds the result row (+ / −), exchanges 10 pieces for 1 on the left, breaks 1 into 10 on the
   right (subtraction), then writes the number. Columns and digits: decimalBlocks() in player.js #}
<div x-show="cur.type === 'decimal-blocks'" class="mb-6">
  <div x-show="cur.body" x-html="cur.body" class="prose dark:prose-invert text-sm text-center max-w-none text-content-subtle mb-3"></div>
  <template x-if="dbkView">
    <div class="flex flex-col items-center gap-4">
      <p class="text-2xl font-bold text-content-default" x-text="cur.dbk.a + ' ' + (dbkView.op === '-' ? '−' : '+') + ' ' + cur.dbk.b"></p>
      <div class="max-w-full overflow-x-auto">
        <table class="border-collapse">
          <thead>
            <tr>
              <th class="w-6"></th>
              <template x-for="(pl, i) in dbkView.places" :key="'h' + i">
                <th class="px-1 pt-1 pb-2 border border-slate-300 dark:border-slate-600 text-base font-bold text-content-default" :class="i === dbkView.firstDecimal ? 'border-l-4 border-l-slate-600 dark:border-l-slate-300' : ''">
                  <div class="flex flex-col items-center gap-1">
                    <span x-text="pl.label"></span>
                    <span class="w-5 h-5 rounded-full border-2" :class="pl.color" aria-hidden="true"></span>
                  </div>
                </th>
              </template>
            </tr>
          </thead>
          <tbody>
            {# The two numbers, drawn #}
            <template x-for="(row, ri) in [dbkView.a, dbkView.b]" :key="'n' + ri">
              <tr>
                <td class="text-center text-2xl font-bold text-content-default align-middle" x-text="ri ? (dbkView.op === '-' ? '−' : '+') : ''"></td>
                <template x-for="(n, i) in row" :key="'n' + ri + '-' + i">
                  <td class="p-1.5 border border-slate-300 dark:border-slate-600 align-top" :class="i === dbkView.firstDecimal ? 'border-l-4 border-l-slate-600 dark:border-l-slate-300' : ''">
                    <div class="grid grid-cols-5 gap-0.5 w-[3.6rem] sm:w-[4.6rem] min-h-[1.5rem]" :aria-label="n + ' × ' + dbkView.places[i].label">
                      <template x-for="k in n" :key="k"><span class="aspect-square rounded-sm border" :class="dbkView.places[i].color"></span></template>
                    </div>
                  </td>
                </template>
              </tr>
            </template>
            {# Result row: built by the pupil #}
            <tr>
              <td class="text-center text-2xl font-bold text-content-default align-middle">=</td>
              <template x-for="(n, i) in dbkCounts" :key="'r' + i">
                <td class="p-1.5 border-2 align-top" :class="[dbkErrors.includes(i) ? 'border-red-400 bg-red-50 dark:bg-red-900/20' : solved ? 'border-green-500 bg-green-50 dark:bg-green-900/20' : 'border-slate-400 dark:border-slate-500', i === dbkView.firstDecimal ? 'border-l-4' : '']">
                  <div class="flex flex-col items-center gap-1.5">
                    <div class="grid grid-cols-5 gap-0.5 w-[3.6rem] sm:w-[4.6rem] min-h-[2.75rem] content-start" :aria-label="n + ' pièces'">
                      <template x-for="k in n" :key="k"><span class="aspect-square rounded-sm border" :class="[dbkView.places[i].color, n >= 10 && k <= 10 ? 'ring-1 ring-red-500' : '']"></span></template>
                    </div>
                    <span class="text-xs font-bold text-content-subtle" x-text="n"></span>
                    <div class="flex gap-1">
                      <button type="button" @click="dbkAdd(i, -1)" :disabled="solved || !n" :aria-label="'Enlever une pièce de ' + dbkView.places[i].label" class="w-7 h-9 sm:w-9 rounded-lg border-2 border-slate-300 dark:border-slate-600 text-lg font-bold disabled:opacity-40">−</button>
                      <button type="button" @click="dbkAdd(i, 1)" :disabled="solved" :aria-label="'Ajouter une pièce de ' + dbkView.places[i].label" class="w-7 h-9 sm:w-9 rounded-lg border-2 border-primary-400 text-primary-700 dark:text-primary-300 text-lg font-bold disabled:opacity-40">+</button>
                    </div>
                    <button type="button" x-show="i > 0 && n >= 10 && !solved" @click="dbkExchange(i)" class="w-full px-1 h-9 rounded-lg bg-amber-100 dark:bg-amber-900/40 border-2 border-amber-500 text-xs font-bold text-amber-900 dark:text-amber-100" :aria-label="'Échanger 10 pièces de ' + dbkView.places[i].label + ' contre 1 pièce de ' + (dbkView.places[i - 1] || {}).label">← 10 → 1</button>
                    <button type="button" x-show="dbkView.op === '-' && i < dbkCounts.length - 1 && n >= 1 && !solved" @click="dbkBreak(i)" class="w-full px-1 h-9 rounded-lg bg-sky-100 dark:bg-sky-900/40 border-2 border-sky-500 text-xs font-bold text-sky-900 dark:text-sky-100" :aria-label="'Casser 1 pièce de ' + dbkView.places[i].label + ' en 10 pièces de ' + (dbkView.places[i + 1] || {}).label">1 → 10 →</button>
                  </div>
                </td>
              </template>
            </tr>
          </tbody>
        </table>
      </div>

      {# The result as a number #}
      <label class="flex items-center gap-3 text-lg font-semibold text-content-default">
        <span x-text="cur.dbk.a + ' ' + (dbkView.op === '-' ? '−' : '+') + ' ' + cur.dbk.b + ' ='"></span>
        <input type="text" inputmode="decimal" autocomplete="off" x-model="dbkInput" @keydown.enter="check()" @input="dbkHint = ''" :disabled="solved" placeholder="?"
               class="w-32 h-12 text-xl text-center rounded-xl border-2 font-bold focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white dark:bg-slate-800"
               :class="solved ? 'border-green-500 bg-green-50 dark:bg-green-900/20' : 'border-slate-300 dark:border-slate-600'" />
      </label>

      <button type="button" @click="check()" :disabled="solved || !dbkInput.trim()"
        class="px-6 py-3 text-lg font-bold rounded-xl transition-all active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed"
        :class="solved ? 'bg-green-500 text-white' : 'bg-primary-500 text-white hover:bg-primary-600 shadow-md'">
        <span x-show="!solved">Vérifier</span>
        <span x-show="solved">Bravo !</span>
      </button>
    </div>
  </template>
</div>
