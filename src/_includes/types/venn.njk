{# Venn — classify items into two overlapping circles #}
<div x-show="cur.type === 'venn'" class="space-y-4">
  {# Body text #}
  <div x-show="cur.body" x-html="cur.body" class="prose dark:prose-invert text-sm text-center max-w-none text-content-subtle"></div>

  <template x-if="cur.venn">
    <div>
      {# Venn diagram — SVG circles + HTML zone overlays #}
      <div class="relative mx-auto" style="width: 340px; height: 240px;">
        {# SVG circles as background #}
        <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 340 240">
          <circle cx="130" cy="125" r="105" fill="none" stroke="currentColor" stroke-width="2.5"
            class="text-blue-400 dark:text-blue-500"/>
          <circle cx="210" cy="125" r="105" fill="none" stroke="currentColor" stroke-width="2.5"
            class="text-rose-400 dark:text-rose-500"/>
          {# Light fills #}
          <circle cx="130" cy="125" r="104" class="fill-blue-100/50 dark:fill-blue-900/20" style="mix-blend-mode:multiply"/>
          <circle cx="210" cy="125" r="104" class="fill-rose-100/50 dark:fill-rose-900/20" style="mix-blend-mode:multiply"/>
        </svg>

        {# Labels above circles #}
        <div class="absolute top-0 left-0 w-[155px] text-center">
          <span class="text-xs font-bold text-blue-600 dark:text-blue-400" x-text="cur.venn.labelA"></span>
        </div>
        <div class="absolute top-0 right-0 w-[155px] text-center">
          <span class="text-xs font-bold text-rose-600 dark:text-rose-400" x-text="cur.venn.labelB"></span>
        </div>

        {# Zone A only — left crescent #}
        <div class="absolute cursor-pointer rounded-l-full"
          style="left: 25px; top: 30px; width: 105px; height: 190px;"
          @click="vennPlaceZone('a')"
          :class="{'ring-2 ring-blue-400 ring-inset': vennSelected !== null}">
          <div class="flex flex-wrap content-center justify-center gap-1 w-full h-full p-2 pointer-events-none">
            <template x-for="(it, i) in cur.venn.items" :key="'pa'+i">
              <span x-show="vennPlacements[i] === 'a'" class="text-2xl leading-none" x-text="it.char"></span>
            </template>
          </div>
        </div>

        {# Zone AB — intersection center #}
        <div class="absolute cursor-pointer z-10"
          style="left: 130px; top: 30px; width: 80px; height: 190px;"
          @click="vennPlaceZone('ab')">
          <div class="flex flex-wrap content-center justify-center gap-1 w-full h-full p-1 pointer-events-none">
            <template x-for="(it, i) in cur.venn.items" :key="'pab'+i">
              <span x-show="vennPlacements[i] === 'ab'" class="text-2xl leading-none" x-text="it.char"></span>
            </template>
          </div>
        </div>

        {# Zone B only — right crescent #}
        <div class="absolute cursor-pointer rounded-r-full"
          style="right: 25px; top: 30px; width: 105px; height: 190px;"
          @click="vennPlaceZone('b')"
          :class="{'ring-2 ring-rose-400 ring-inset': vennSelected !== null}">
          <div class="flex flex-wrap content-center justify-center gap-1 w-full h-full p-2 pointer-events-none">
            <template x-for="(it, i) in cur.venn.items" :key="'pb'+i">
              <span x-show="vennPlacements[i] === 'b'" class="text-2xl leading-none" x-text="it.char"></span>
            </template>
          </div>
        </div>
      </div>

      {# Outside zone #}
      <div class="flex justify-center">
        <div class="px-4 py-2 rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-600 min-h-[2.5rem] min-w-[140px] flex flex-wrap justify-center gap-1 cursor-pointer"
          @click="vennPlaceZone('out')"
          :class="{'ring-2 ring-slate-400': vennSelected !== null}">
          <span class="text-xs text-content-subtle self-center" x-show="!Object.values(vennPlacements).some(v => v === 'out')">Ni l'un ni l'autre</span>
          <template x-for="(it, i) in cur.venn.items" :key="'po'+i">
            <span x-show="vennPlacements[i] === 'out'" class="text-2xl leading-none" x-text="it.char"></span>
          </template>
        </div>
      </div>

      {# Item bank — unplaced items, tap to select #}
      <div class="flex flex-wrap justify-center gap-2 mt-4">
        <template x-for="(it, i) in cur.venn.items" :key="'bank'+i">
          <button type="button"
            x-show="!vennPlacements[i]"
            @click="vennSelect(i)"
            :disabled="solved"
            class="w-12 h-12 text-2xl rounded-xl border-2 transition-all flex items-center justify-center"
            :class="{
              'border-primary-500 bg-primary-100 dark:bg-primary-900/30 ring-2 ring-primary-300': vennSelected === i,
              'border-red-400 bg-red-50 dark:bg-red-900/20': vennErrors.includes(i),
              'border-slate-200 dark:border-slate-700 bg-surface-subtle hover:border-slate-300': vennSelected !== i && !vennErrors.includes(i)
            }"
            x-text="it.char">
          </button>
        </template>
      </div>

      {# Verify button #}
      <div class="flex justify-center mt-4">
        <button type="button" @click="check()"
          :disabled="solved || Object.keys(vennPlacements).length < cur.venn.items.length"
          class="px-8 py-3 text-lg font-bold rounded-xl transition-all active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed"
          :class="solved ? 'bg-green-500 text-white' : 'bg-primary-500 text-white hover:bg-primary-600 shadow-md'">
          <span x-show="!solved">Vérifier</span>
          <span x-show="solved">Bravo !</span>
        </button>
      </div>
    </div>
  </template>
</div>
