{# Venn — classify items into two overlapping circles #}
<div x-show="cur.type === 'venn'" class="space-y-4">
  {# Body text #}
  <div x-show="cur.body" x-html="cur.body" class="prose dark:prose-invert text-sm text-center max-w-none text-content-subtle"></div>

  <template x-if="cur.venn">
    <div>
      {# Venn diagram — SVG circles + clip-path zones #}
      <div class="relative mx-auto" style="width: 340px; height: 230px;">
        {# SVG circles (visual) #}
        <svg class="absolute inset-0 w-full h-full pointer-events-none z-0" viewBox="0 0 340 230">
          <circle cx="130" cy="120" r="100" class="fill-blue-50 dark:fill-blue-950/30"/>
          <circle cx="210" cy="120" r="100" class="fill-rose-50 dark:fill-rose-950/30"/>
          <circle cx="130" cy="120" r="100" fill="none" stroke-width="2.5" class="stroke-blue-400 dark:stroke-blue-500"/>
          <circle cx="210" cy="120" r="100" fill="none" stroke-width="2.5" class="stroke-rose-400 dark:stroke-rose-500"/>
        </svg>

        {# Labels above circles #}
        <div class="absolute z-30 pointer-events-none" style="top: 4px; left: 10px; width: 130px; text-align: center;">
          <span class="text-xs font-bold text-blue-600 dark:text-blue-400 bg-white/80 dark:bg-slate-900/80 px-1.5 py-0.5 rounded" x-text="cur.venn.labelA"></span>
        </div>
        <div class="absolute z-30 pointer-events-none" style="top: 4px; right: 10px; width: 130px; text-align: center;">
          <span class="text-xs font-bold text-rose-600 dark:text-rose-400 bg-white/80 dark:bg-slate-900/80 px-1.5 py-0.5 rounded" x-text="cur.venn.labelB"></span>
        </div>

        {# Zone A — full container clipped to left circle #}
        <div class="absolute inset-0 cursor-pointer z-10"
          style="clip-path: circle(100px at 130px 120px);"
          @click="vennPlaceZone('a')">
          <div class="absolute flex flex-wrap content-center justify-center gap-1 p-1"
            style="left: 30px; top: 40px; width: 80px; height: 160px;">
            <template x-for="(it, i) in cur.venn.items" :key="'pa'+i">
              <span x-show="vennPlacements[i] === 'a'" class="text-2xl leading-none" x-text="it.char"></span>
            </template>
          </div>
        </div>

        {# Zone B — full container clipped to right circle #}
        <div class="absolute inset-0 cursor-pointer z-10"
          style="clip-path: circle(100px at 210px 120px);"
          @click="vennPlaceZone('b')">
          <div class="absolute flex flex-wrap content-center justify-center gap-1 p-1"
            style="right: 30px; top: 40px; width: 80px; height: 160px;">
            <template x-for="(it, i) in cur.venn.items" :key="'pb'+i">
              <span x-show="vennPlacements[i] === 'b'" class="text-2xl leading-none" x-text="it.char"></span>
            </template>
          </div>
        </div>

        {# Zone AB — intersection, higher z-index captures clicks in overlap #}
        <div class="absolute cursor-pointer z-20"
          style="left: 110px; top: 20px; width: 120px; height: 200px;"
          @click="vennPlaceZone('ab')">
          <div class="flex flex-wrap content-center justify-center gap-1 w-full h-full p-1">
            <template x-for="(it, i) in cur.venn.items" :key="'pab'+i">
              <span x-show="vennPlacements[i] === 'ab'" class="text-2xl leading-none" x-text="it.char"></span>
            </template>
          </div>
        </div>
      </div>

      {# Outside zone #}
      <div class="flex justify-center">
        <div class="px-4 py-2 rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-600 min-h-[2.5rem] min-w-[140px] flex flex-wrap justify-center items-center gap-1 cursor-pointer"
          @click="vennPlaceZone('out')">
          <span class="text-xs text-content-subtle" x-show="!Object.values(vennPlacements).some(v => v === 'out')">Ni l'un ni l'autre</span>
          <template x-for="(it, i) in cur.venn.items" :key="'po'+i">
            <span x-show="vennPlacements[i] === 'out'" class="text-2xl leading-none" x-text="it.char"></span>
          </template>
        </div>
      </div>

      {# Item bank — unplaced items, tap to select #}
      <div class="flex flex-wrap justify-center gap-2 mt-4">
        <template x-for="(it, i) in cur.venn.items" :key="'bank'+i">
          <button type="button"
            x-show="!vennPlacements[i]"
            @click="vennSelect(i)"
            :disabled="solved"
            class="w-12 h-12 text-2xl rounded-xl border-2 transition-all flex items-center justify-center"
            :class="{
              'border-primary-500 bg-primary-100 dark:bg-primary-900/30 ring-2 ring-primary-300': vennSelected === i,
              'border-red-400 bg-red-50 dark:bg-red-900/20': vennErrors.includes(i),
              'border-slate-200 dark:border-slate-700 bg-surface-subtle hover:border-slate-300': vennSelected !== i && !vennErrors.includes(i)
            }"
            x-text="it.char">
          </button>
        </template>
      </div>

      {# Verify button #}
      <div class="flex justify-center mt-4">
        <button type="button" @click="check()"
          :disabled="solved || Object.keys(vennPlacements).length < cur.venn.items.length"
          class="px-8 py-3 text-lg font-bold rounded-xl transition-all active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed"
          :class="solved ? 'bg-green-500 text-white' : 'bg-primary-500 text-white hover:bg-primary-600 shadow-md'">
          <span x-show="!solved">Vérifier</span>
          <span x-show="solved">Bravo !</span>
        </button>
      </div>
    </div>
  </template>
</div>
