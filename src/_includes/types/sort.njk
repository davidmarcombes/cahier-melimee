<div x-show="cur.type === 'sort'" class="space-y-4">
  <template x-if="cur.svg">
    <div class="flex justify-center mb-4" x-html="(() => { try { return window[cur.svg.gen](...Object.values(cur.svg.par)); } catch(e) { console.error('svg error', e); return ''; } })()"></div>
  </template>
  <div x-show="cur.body" x-html="cur.body" class="prose dark:prose-invert text-sm text-center mb-4 max-w-none text-content-subtle"></div>

  {# Tile pool — unselected items #}
  <div class="flex flex-wrap justify-center rounded-xl bg-surface-subtle border border-slate-200 dark:border-slate-700"
    :class="sortLong ? 'gap-1.5 p-2 min-h-[2.75rem]' : 'gap-3 p-4 min-h-[4.5rem]'">
    <template x-for="(item, i) in sortShuffled" :key="i">
      <button type="button" x-show="!sortPicked.includes(i)"
        @click="sortTap(i)" :disabled="solved"
        class="rounded-xl border-2 transition-all active:scale-95 select-none border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-content-default hover:border-primary-400 hover:bg-primary-50 dark:hover:bg-primary-900/20"
        :class="sortLong ? 'w-full px-3 py-1.5 text-sm font-medium text-left' : 'px-6 py-3 font-semibold text-lg'"
        x-text="item">
      </button>
    </template>
    <span x-show="sortPicked.length === (cur.items ? cur.items.length : 0)" class="text-content-subtle text-sm italic self-center">Tous les éléments sont placés</span>
  </div>

  {# Direction label #}
  <div class="flex items-center gap-2 text-xs text-content-subtle px-1">
    <span x-text="cur.sortLabels ? cur.sortLabels[0] : cur.direction === 'desc' ? 'plus grand' : 'plus petit'"></span>
    <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700 relative">
      <svg class="absolute right-0 top-1/2 -translate-y-1/2" width="8" height="8" viewBox="0 0 8 8"><path d="M0 4h7M4 1l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
    </div>
    <span x-text="cur.sortLabels ? cur.sortLabels[1] : cur.direction === 'desc' ? 'plus petit' : 'plus grand'"></span>
  </div>

  {# Answer track — placed items + empty slots #}
  <div class="flex flex-wrap justify-center" :class="sortLong ? 'gap-1.5' : 'gap-3'">
    <template x-for="(idx, rank) in sortPicked" :key="rank">
      <button type="button" @click="sortUnpick(rank)" :disabled="solved"
        class="rounded-xl border-2 transition-all active:scale-95 select-none"
        :class="{
          'w-full px-3 py-1.5 text-sm font-medium text-left': sortLong,
          'px-6 py-3 font-semibold text-lg': !sortLong,
          'border-green-400 bg-green-50 dark:bg-green-900/20 text-green-800 dark:text-green-200': solved,
          'border-red-400 bg-red-50 dark:bg-red-900/20 text-red-800 dark:text-red-200': sortErrors.includes(rank),
          'border-primary-500 bg-primary-50 dark:bg-primary-900/20 text-content-default': !solved && !sortErrors.includes(rank)
        }">
        <span class="text-xs opacity-60 mr-1" x-text="rank + 1 + '.'"></span>
        <span x-text="sortShuffled[idx]"></span>
      </button>
    </template>
    <template x-for="n in Math.max(0, (cur.items ? cur.items.length : 0) - sortPicked.length)" :key="n">
      <div class="rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-600 text-content-subtle font-semibold text-center"
        :class="sortLong ? 'px-2 py-0.5 text-sm min-w-[2.5rem]' : 'px-6 py-3 text-lg min-w-[4rem]'">
        <span x-text="sortPicked.length + n + '.'"></span>
      </div>
    </template>
  </div>

  {# Verify button #}
  <div x-show="!solved && sortPicked.length === (cur.items ? cur.items.length : 0)" class="flex justify-center pt-2">
    <button type="button" @click="check()"
      class="px-6 py-2 text-sm font-bold rounded-xl bg-primary-500 text-white hover:bg-primary-600 transition-all active:scale-95">
      Vérifier
    </button>
  </div>
</div>
