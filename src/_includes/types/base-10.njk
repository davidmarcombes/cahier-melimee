{# Base-10 Blocks Visualization #}
<div x-show="cur.type === 'base-10'" class="flex flex-col items-center mb-6 w-full">
  <div class="w-full overflow-x-auto flex justify-center py-4">
    <div class="flex justify-center">
      <svg
        x-data="{ get r() { return base10Render(cur.base10); } }"
        :viewBox="'0 0 ' + r.width + ' ' + r.height"
        :width="r.width"
        :height="r.height"
        class="b10 max-h-40 sm:max-h-48 overflow-visible"
        style="width:auto;height:auto;display:block"
        x-html="r.markup"
      >
      </svg>
    </div>
  </div>

  {# Instructions from body #}
  <div class="mt-4 prose dark:prose-invert text-base text-center mb-4 max-w-none italic text-content-subtle" x-html="cur.body"></div>
</div>
