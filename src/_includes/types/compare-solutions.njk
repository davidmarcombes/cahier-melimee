{# Compare Solutions — two worked solutions side by side, click the correct one #}
<div x-show="cur.type === 'compare-solutions'" class="mb-8">

  <p class="text-sm text-content-subtle text-center mb-5 italic">Clique sur la bonne solution.</p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
    <template x-for="(sol, i) in (cur.csSolutions || [])" :key="i">
      <button
        type="button"
        @click="if (!solved) csSelected = i"
        :disabled="solved"
        class="flex flex-col gap-2 p-5 rounded-2xl border-2 text-left transition-all duration-150 select-none"
        :class="{
          'border-primary-500 bg-primary-50 dark:bg-primary-900/20 shadow-md scale-[1.01]': csSelected === i && !solved,
          'border-green-500 bg-green-50 dark:bg-green-900/20': solved && i === cur.correctSolution,
          'border-red-400 bg-red-50 dark:bg-red-900/20': solved && csSelected === i && i !== cur.correctSolution,
          'opacity-40 cursor-not-allowed': solved && i !== cur.correctSolution && csSelected !== i,
          'border-slate-200 dark:border-slate-700 hover:border-primary-300 hover:shadow cursor-pointer': !solved && csSelected !== i
        }"
      >
        <span class="text-sm font-bold text-content-subtle mb-1" x-text="sol.name"></span>
        <template x-for="(step, j) in (sol.steps || [])" :key="j">
          <span class="font-mono text-lg leading-snug" x-text="step"></span>
        </template>
      </button>
    </template>
  </div>

  <button
    type="button"
    @click="check()"
    :disabled="solved || csSelected === null"
    class="w-full px-6 py-3 text-lg font-bold rounded-xl transition-all active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed"
    :class="solved ? 'bg-green-500 text-white' : 'bg-primary-500 text-white hover:bg-primary-600 shadow-md'"
  >
    <span x-show="!solved">Vérifier</span>
    <span x-show="solved">Bravo !</span>
  </button>
</div>
