{# broken-calc — a pocket calculator (left to right) with broken keys: make it show the target.
   Keys missing from cur.calc.ops stay blank; broken keys are crossed out. Data: cur.calc #}
<div x-show="cur.type === 'broken-calc'" class="mb-6">
  <div x-show="cur.body" x-html="cur.body" class="prose dark:prose-invert text-sm text-center max-w-none text-content-subtle mb-3"></div>
  <template x-if="cur.calc">
    <div class="flex flex-col items-center gap-4">
      <p class="js-bc-prompt text-center text-lg text-content-default" x-html="calcPrompt"></p>
      <div class="w-72 max-w-full rounded-3xl bg-slate-700 dark:bg-slate-900 p-4 shadow-lg">
        <div class="rounded-lg bg-lime-100 px-3 py-2 mb-3 text-right font-mono text-slate-900">
          <div class="js-bc-tape text-xs h-4 overflow-hidden text-slate-600" x-text="calcTape.join(' ')"></div>
          <div class="js-bc-display text-4xl font-bold tabular-nums truncate" :class="solved ? 'text-green-700' : ''" x-text="calcDisplay"></div>
        </div>
        <div class="grid grid-cols-4 gap-2">
          <template x-for="k in ['7', '8', '9', '÷', '4', '5', '6', '×', '1', '2', '3', '−', 'C', '0', '=', '+']" :key="k">
            <button type="button" @click="calcKey(k)" :disabled="solved || calcBroken(k) || !calcHas(k)" :aria-label="calcBroken(k) ? k + ' (cassée)' : k"
              class="js-bc-key relative h-12 rounded-xl text-2xl font-bold transition-all active:scale-95"
              :class="!calcHas(k) ? 'invisible' : calcBroken(k) ? 'bg-red-200 text-red-800 line-through cursor-not-allowed' : k === '=' ? 'bg-amber-400 text-slate-900 hover:bg-amber-300' : 'C÷×−+'.includes(k) ? 'bg-slate-500 text-white hover:bg-slate-400' : 'bg-slate-100 text-slate-900 hover:bg-white'">
              <span x-text="k"></span>
              <span x-show="calcBroken(k)" class="absolute -top-1 -right-1 text-base" aria-hidden="true">🚫</span>
            </button>
          </template>
        </div>
      </div>
      <p x-show="calcHint" class="text-sm font-semibold text-amber-700 dark:text-amber-300" x-text="calcHint"></p>
    </div>
  </template>
</div>
