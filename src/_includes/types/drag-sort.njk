{# drag-sort type — click a tile to select it, click another to swap; tiles support x-html #}
<div x-show="cur.type === 'drag-sort'" class="bg-surface-subtle rounded-2xl shadow-lg border border-slate-200 dark:border-slate-700 p-6 mb-8">

  {# Optional body #}
  <div x-show="cur.body" x-html="cur.body" class="prose dark:prose-invert text-sm text-center mb-4 max-w-none text-content-subtle"></div>

  {# Direction indicator #}
  <template x-if="cur.direction">
    <div class="flex items-center gap-3 mb-5 px-1">
      <div class="flex flex-col items-center leading-tight">
        <span class="text-lg" x-text="cur.direction === 'desc' ? '🐘' : '🐭'"></span>
        <span class="text-xs font-semibold text-content-subtle" x-text="cur.direction === 'desc' ? 'grand' : 'petit'"></span>
      </div>
      <div class="flex-1 h-0.5 bg-slate-300 dark:bg-slate-600 relative">
        <svg class="absolute right-0 top-1/2 -translate-y-1/2 text-slate-500 dark:text-slate-400" width="16" height="16" viewBox="0 0 8 8" aria-hidden="true">
          <path d="M0 4h7M4 1l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
      </div>
      <div class="flex flex-col items-center leading-tight">
        <span class="text-lg" x-text="cur.direction === 'desc' ? '🐭' : '🐘'"></span>
        <span class="text-xs font-semibold text-content-subtle" x-text="cur.direction === 'desc' ? 'petit' : 'grand'"></span>
      </div>
    </div>
  </template>

  {# Tile row #}
  <div class="flex flex-nowrap justify-center gap-1.5 mb-2">
    <template x-for="(origIdx, pos) in dragTilesOrder" :key="origIdx">
      <div class="flex flex-col items-center gap-1 flex-1 min-w-0">
        {# Position number #}
        <span class="text-xs font-semibold"
              :class="solved ? 'text-green-600 dark:text-green-400' : 'text-content-subtle'"
              x-text="pos + 1"></span>
        {# Tile button #}
        <button
          type="button"
          @click="dragTap(+pos)"
          :disabled="solved"
          class="w-full px-2 py-3 text-3xl font-bold rounded-2xl border-2 transition-all duration-150 select-none bg-white dark:bg-slate-800"
          :class="{
            'border-primary-500 bg-primary-50 dark:bg-primary-900/20 scale-105 shadow-lg ring-2 ring-primary-300 dark:ring-primary-700':
              dragSelected === +pos && !solved,
            'border-green-400 bg-green-50 dark:bg-green-900/20 text-green-800 dark:text-green-200':
              solved,
            'border-red-400 bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-300':
              dragErrors.includes(+pos) && !solved,
            'border-slate-200 dark:border-slate-700 hover:border-primary-300 hover:shadow cursor-pointer':
              !solved && dragSelected !== +pos && !dragErrors.includes(+pos)
          }"
          x-html="dragRender((cur.tiles || [])[origIdx])"
        ></button>
      </div>
    </template>
  </div>

  {# Swap hint #}
  <p x-show="dragSelected !== null && !solved"
     class="text-center text-xs text-primary-600 dark:text-primary-400 italic mb-4 mt-2">
    Clique sur une autre case pour échanger.
  </p>
  <div x-show="dragSelected === null || solved" class="mb-4 mt-2 h-4"></div>

  {# Verify button #}
  <div class="flex justify-center">
    <button
      type="button"
      @click="check()"
      :disabled="solved"
      class="px-8 py-2.5 text-base font-bold rounded-xl transition-all active:scale-95
             disabled:opacity-40 disabled:cursor-not-allowed"
      :class="solved ? 'bg-green-500 text-white' : 'bg-primary-500 text-white hover:bg-primary-600 shadow-md'"
    >
      <span x-show="!solved">Vérifier</span>
      <span x-show="solved">Bravo !</span>
    </button>
  </div>
</div>
