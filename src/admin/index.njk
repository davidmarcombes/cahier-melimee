---
layout: admin
title: Dashboard
permalink: /admin/
---

<script id="admin-data" type="application/json">{{ adminReport | dump | safe }}</script>

<div x-data="adminDashboard()" x-cloak class="space-y-4">

  {# ── Stats bar ──────────────────────────────────────────────────────────── #}
  <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3">
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-3 text-center">
      <div class="text-2xl font-black text-slate-700 dark:text-slate-200" x-text="rows.length"></div>
      <div class="text-xs text-slate-400 mt-0.5">Séries total</div>
    </div>
    <template x-for="(count, lvl) in levelCounts" :key="lvl">
      <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-3 text-center">
        <div class="text-2xl font-black text-primary-600 dark:text-primary-400" x-text="count"></div>
        <div class="text-xs text-slate-400 mt-0.5" x-text="lvl"></div>
      </div>
    </template>
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-3 text-center">
      <div class="text-2xl font-black text-green-600 dark:text-green-400" x-text="humanOkCount"></div>
      <div class="text-xs text-slate-400 mt-0.5">Validées ✓</div>
    </div>
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-3 text-center">
      <div class="text-2xl font-black text-slate-400" x-text="rows.length - humanOkCount"></div>
      <div class="text-xs text-slate-400 mt-0.5">À valider</div>
    </div>
  </div>

  {# ── Filter bar ─────────────────────────────────────────────────────────── #}
  <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-4 space-y-3">

    {# Search #}
    <div class="flex gap-2">
      <input type="search" x-model="search" placeholder="Rechercher titre, chemin, ID…"
             class="flex-1 px-3 py-2 text-sm rounded-lg border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary-400"/>
      <button type="button" @click="resetFilters()" class="px-3 py-2 text-xs rounded-lg border border-slate-200 dark:border-slate-600 text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
        Réinitialiser
      </button>
      <span class="px-3 py-2 text-xs text-slate-400 self-center" x-text="filtered.length + ' / ' + rows.length"></span>
    </div>

    {# Toggle groups #}
    <div class="flex flex-wrap gap-4">

      <div class="flex items-center gap-1.5">
        <span class="text-xs font-medium text-slate-400 uppercase tracking-wide">Type</span>
        <template x-for="k in ['exercice','application','defi']" :key="k">
          <button type="button" @click="toggleArr('kinds', k)"
                  :class="filters.kinds.includes(k) ? 'bg-primary-500 text-white' : 'bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300'"
                  class="px-2 py-0.5 rounded-md text-xs font-medium transition-colors" x-text="k"></button>
        </template>
      </div>

      <div class="flex items-center gap-1.5">
        <span class="text-xs font-medium text-slate-400 uppercase tracking-wide">Niveau</span>
        <template x-for="lvl in allLevels" :key="lvl">
          <button type="button" @click="toggleArr('levels', lvl)"
                  :class="filters.levels.includes(lvl) ? 'bg-primary-500 text-white' : 'bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300'"
                  class="px-2 py-0.5 rounded-md text-xs font-medium transition-colors" x-text="lvl"></button>
        </template>
      </div>

      <div class="flex items-center gap-1.5">
        <span class="text-xs font-medium text-slate-400 uppercase tracking-wide">Difficulté</span>
        <template x-for="d in ['facile','moyen','difficile']" :key="d">
          <button type="button" @click="toggleArr('difficulties', d)"
                  :class="filters.difficulties.includes(d) ? 'bg-primary-500 text-white' : 'bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300'"
                  class="px-2 py-0.5 rounded-md text-xs font-medium transition-colors" x-text="d"></button>
        </template>
      </div>

      <div class="flex items-center gap-1.5">
        <span class="text-xs font-medium text-slate-400 uppercase tracking-wide">Humain</span>
        <template x-for="s in [{v:'ok',l:'✓'},{v:'partial',l:'partiel'},{v:'pending',l:'✗'}]" :key="s.v">
          <button type="button" @click="filters.humanStatus = filters.humanStatus === s.v ? '' : s.v"
                  :class="filters.humanStatus === s.v ? 'bg-primary-500 text-white' : 'bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300'"
                  class="px-2 py-0.5 rounded-md text-xs font-medium transition-colors" x-text="s.l"></button>
        </template>
      </div>

      <div class="flex items-center gap-1.5">
        <span class="text-xs font-medium text-slate-400 uppercase tracking-wide">LLM</span>
        <template x-for="s in [{v:'ok',l:'✓'},{v:'fail',l:'✗'},{v:'pending',l:'—'}]" :key="s.v">
          <button type="button" @click="filters.llmStatus = filters.llmStatus === s.v ? '' : s.v"
                  :class="filters.llmStatus === s.v ? 'bg-primary-500 text-white' : 'bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300'"
                  class="px-2 py-0.5 rounded-md text-xs font-medium transition-colors" x-text="s.l"></button>
        </template>
      </div>

      <div class="flex items-center gap-1.5">
        <span class="text-xs font-medium text-slate-400 uppercase tracking-wide">Template</span>
        <select x-model="filters.template"
                class="px-2 py-0.5 rounded-md text-xs font-medium border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary-400 cursor-pointer">
          <option value="">Tous</option>
          <template x-for="t in allTemplates" :key="t">
            <option :value="t" x-text="t"></option>
          </template>
        </select>
      </div>

      <label class="flex items-center gap-1.5 cursor-pointer select-none ml-auto">
        <input type="checkbox" x-model="filters.onePerTemplate"
               class="w-3.5 h-3.5 rounded border-slate-300 dark:border-slate-600 text-primary-500 accent-primary-500 cursor-pointer"/>
        <span class="text-xs font-medium text-slate-600 dark:text-slate-300">1 par template</span>
        <span class="text-xs text-slate-400" x-show="filters.onePerTemplate" x-text="'(' + filtered.length + ' séries)'"></span>
      </label>

    </div>
  </div>

  {# ── Table ──────────────────────────────────────────────────────────────── #}
  <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-slate-50 dark:bg-slate-900/50 border-b border-slate-200 dark:border-slate-700">
            <th @click="sortBy('seriesTitle')" :class="sort.col==='seriesTitle' && 'active'" class="text-left px-3 py-2.5 font-semibold text-slate-500 dark:text-slate-400 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 whitespace-nowrap select-none">
              Titre <span class="sort-icon" x-text="sort.col==='seriesTitle' ? (sort.dir==='asc' ? '↑' : '↓') : '↕'"></span>
            </th>
            <th @click="sortBy('kind')" :class="sort.col==='kind' && 'active'" class="text-left px-3 py-2.5 font-semibold text-slate-500 dark:text-slate-400 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 whitespace-nowrap select-none">
              Type <span class="sort-icon" x-text="sort.col==='kind' ? (sort.dir==='asc' ? '↑' : '↓') : '↕'"></span>
            </th>
            <th @click="sortBy('level')" :class="sort.col==='level' && 'active'" class="text-left px-3 py-2.5 font-semibold text-slate-500 dark:text-slate-400 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 whitespace-nowrap select-none">
              Niveau <span class="sort-icon" x-text="sort.col==='level' ? (sort.dir==='asc' ? '↑' : '↓') : '↕'"></span>
            </th>
            <th @click="sortBy('topic')" :class="sort.col==='topic' && 'active'" class="text-left px-3 py-2.5 font-semibold text-slate-500 dark:text-slate-400 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 whitespace-nowrap select-none">
              Thème <span class="sort-icon" x-text="sort.col==='topic' ? (sort.dir==='asc' ? '↑' : '↓') : '↕'"></span>
            </th>
            <th @click="sortBy('types')" :class="sort.col==='types' && 'active'" class="text-left px-3 py-2.5 font-semibold text-slate-500 dark:text-slate-400 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 whitespace-nowrap select-none">
              Template <span class="sort-icon" x-text="sort.col==='types' ? (sort.dir==='asc' ? '↑' : '↓') : '↕'"></span>
            </th>
            <th @click="sortBy('classes')" :class="sort.col==='classes' && 'active'" class="text-left px-3 py-2.5 font-semibold text-slate-500 dark:text-slate-400 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 whitespace-nowrap select-none">
              Classe <span class="sort-icon" x-text="sort.col==='classes' ? (sort.dir==='asc' ? '↑' : '↓') : '↕'"></span>
            </th>
            <th @click="sortBy('difficulty')" :class="sort.col==='difficulty' && 'active'" class="text-left px-3 py-2.5 font-semibold text-slate-500 dark:text-slate-400 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 whitespace-nowrap select-none">
              Diff. <span class="sort-icon" x-text="sort.col==='difficulty' ? (sort.dir==='asc' ? '↑' : '↓') : '↕'"></span>
            </th>
            <th @click="sortBy('repeatTotal')" :class="sort.col==='repeatTotal' && 'active'" class="text-right px-3 py-2.5 font-semibold text-slate-500 dark:text-slate-400 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 whitespace-nowrap select-none">
              Exos <span class="sort-icon" x-text="sort.col==='repeatTotal' ? (sort.dir==='asc' ? '↑' : '↓') : '↕'"></span>
            </th>
            <th @click="sortBy('humanStatus')" :class="sort.col==='humanStatus' && 'active'" class="text-center px-3 py-2.5 font-semibold text-slate-500 dark:text-slate-400 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 whitespace-nowrap select-none">
              Humain <span class="sort-icon" x-text="sort.col==='humanStatus' ? (sort.dir==='asc' ? '↑' : '↓') : '↕'"></span>
            </th>
            <th @click="sortBy('llmStatus')" :class="sort.col==='llmStatus' && 'active'" class="text-center px-3 py-2.5 font-semibold text-slate-500 dark:text-slate-400 cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 whitespace-nowrap select-none">
              LLM <span class="sort-icon" x-text="sort.col==='llmStatus' ? (sort.dir==='asc' ? '↑' : '↓') : '↕'"></span>
            </th>
            <th class="text-left px-3 py-2.5 font-semibold text-slate-500 dark:text-slate-400 whitespace-nowrap">Chemin</th>
          </tr>
        </thead>
        <tbody>
          <template x-if="filtered.length === 0">
            <tr>
              <td colspan="11" class="px-4 py-8 text-center text-slate-400">Aucun résultat</td>
            </tr>
          </template>
          <template x-for="row in filtered" :key="row.id">
            <tr class="border-b border-slate-100 dark:border-slate-700/50 hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors group">

              {# Title + ID #}
              <td class="px-3 py-2 max-w-xs">
                <a href="#" :href="seriesUrl(row)" target="_blank"
                   class="font-medium text-primary-600 dark:text-primary-400 hover:underline leading-tight block truncate"
                   x-text="row.seriesTitle || '(sans titre)'">série</a>
                <span class="text-xs text-slate-400 font-mono" x-text="row.id"></span>
              </td>

              {# Kind badge #}
              <td class="px-3 py-2 whitespace-nowrap">
                <span :class="{
                  'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300': row.kind === 'exercice',
                  'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300': row.kind === 'application',
                  'bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-300': row.kind === 'defi'
                }" class="px-1.5 py-0.5 rounded text-xs font-medium" x-text="row.kind"></span>
              </td>

              {# Level #}
              <td class="px-3 py-2 whitespace-nowrap font-medium text-slate-600 dark:text-slate-300" x-text="row.level"></td>

              {# Topic #}
              <td class="px-3 py-2 whitespace-nowrap text-slate-500 dark:text-slate-400 text-xs" x-text="row.topic"></td>

              {# Template (exercise type) #}
              <td class="px-3 py-2 max-w-[10rem]">
                <span class="text-xs text-slate-500 dark:text-slate-400 leading-snug break-words" x-text="row.types"></span>
              </td>

              {# Curriculum class #}
              <td class="px-3 py-2 max-w-[8rem]">
                <span class="text-xs font-mono text-slate-400 dark:text-slate-500 leading-snug break-words" x-text="row.classes"></span>
              </td>

              {# Difficulty #}
              <td class="px-3 py-2 whitespace-nowrap">
                <span :class="{
                  'text-green-600 dark:text-green-400': row.difficulty === 'facile',
                  'text-amber-600 dark:text-amber-400': row.difficulty === 'moyen',
                  'text-red-600 dark:text-red-400': row.difficulty === 'difficile'
                }" class="text-xs font-medium" x-text="row.difficulty"></span>
              </td>

              {# Exercise count #}
              <td class="px-3 py-2 text-right text-slate-500 dark:text-slate-400 tabular-nums" x-text="row.repeatTotal || row.exerciseCount"></td>

              {# Human validation #}
              <td class="px-3 py-2 text-center whitespace-nowrap">
                <template x-if="row.humanStatus === 'ok'">
                  <span class="inline-flex flex-col items-center">
                    <span class="text-green-600 dark:text-green-400 font-bold">✓</span>
                    <span class="text-xs text-slate-400" x-text="row.humanDate"></span>
                  </span>
                </template>
                <template x-if="row.humanStatus === 'partial'">
                  <span class="text-amber-600 dark:text-amber-400 text-xs font-medium" x-text="row.humanCoverage"></span>
                </template>
                <template x-if="row.humanStatus === 'pending'">
                  <span class="text-slate-300 dark:text-slate-600 font-bold">—</span>
                </template>
              </td>

              {# LLM validation #}
              <td class="px-3 py-2 text-center whitespace-nowrap">
                <template x-if="row.llmStatus === 'ok'">
                  <span class="text-green-600 dark:text-green-400 font-bold" :title="row.llmCoverage">✓</span>
                </template>
                <template x-if="row.llmStatus === 'fail'">
                  <span class="text-red-600 dark:text-red-400 font-bold" :title="row.llmCoverage">✗</span>
                </template>
                <template x-if="row.llmStatus === 'skip'">
                  <span class="text-slate-400 text-xs">skip</span>
                </template>
                <template x-if="row.llmStatus === 'pending'">
                  <span class="text-slate-300 dark:text-slate-600 font-bold">—</span>
                </template>
              </td>

              {# Source path — copyable + open in editor #}
              <td class="px-3 py-2">
                <div class="flex items-center gap-1.5">
                  <button type="button" @click="copy(row.path)" :title="'Copier : ' + row.path"
                          class="text-xs text-slate-400 hover:text-primary-500 font-mono truncate max-w-[11rem] block text-left transition-colors"
                          x-text="row.path"></button>
                  <a x-show="row.absPath" href="#" :href="'vscode://file/' + row.absPath" :title="'Ouvrir dans VS Code'" aria-label="Ouvrir dans VS Code"
                     class="shrink-0 text-slate-300 dark:text-slate-600 hover:text-blue-500 dark:hover:text-blue-400 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M23.15 2.587L18.21.21a1.494 1.494 0 0 0-1.705.29l-9.46 8.63-4.12-3.128a.999.999 0 0 0-1.276.057L.327 7.261A1 1 0 0 0 .326 8.74L3.899 12 .326 15.26a1 1 0 0 0 .001 1.479L1.65 17.94a.999.999 0 0 0 1.276.057l4.12-3.128 9.46 8.63a1.492 1.492 0 0 0 1.704.29l4.942-2.377A1.5 1.5 0 0 0 24 19.08V4.92a1.5 1.5 0 0 0-.85-1.333zm-5.146 14.861L10.826 12l7.178-5.448v10.896z"/></svg>
                  </a>
                  <a x-show="row.absPath" :href="'antigravity://file/' + row.absPath" :title="'Ouvrir dans Antigravity'"
                     class="shrink-0 opacity-40 hover:opacity-100 transition-opacity">
                    <img src="https://antigravity.google/assets/image/brand/antigravity-icon__full-color.png" width="14" height="14" alt="Antigravity"/>
                  </a>
                </div>
              </td>

            </tr>
          </template>
        </tbody>
      </table>
    </div>
  </div>

  {# Copy toast #}
  <div x-show="copied" x-transition.opacity
       class="fixed bottom-6 right-6 bg-slate-800 text-white text-sm px-4 py-2 rounded-xl shadow-lg pointer-events-none">
    Chemin copié !
  </div>

</div>

<script>
function adminDashboard() {
  const raw = JSON.parse(document.getElementById('admin-data').textContent || '[]');

  return {
    rows: raw,
    search: '',
    filters: { kinds: [], levels: [], difficulties: [], humanStatus: '', llmStatus: '', template: '', onePerTemplate: false },
    sort: { col: 'level', dir: 'asc' },
    copied: false,

    get allLevels() {
      return ['CP','CE1','CE2','CM1','CM2'];
    },

    get allTemplates() {
      const set = new Set();
      for (const r of this.rows) {
        if (r.types) r.types.split('|').forEach(t => { const v = t.trim(); if (v) set.add(v); });
      }
      return [...set].sort((a, b) => a.localeCompare(b, 'fr'));
    },

    get levelCounts() {
      const order = ['CP','CE1','CE2','CM1','CM2'];
      const counts = {};
      for (const lvl of order) counts[lvl] = this.rows.filter(r => r.level === lvl).length;
      return counts;
    },

    get humanOkCount() {
      return this.rows.filter(r => r.humanStatus === 'ok').length;
    },

    get filtered() {
      let result = this.rows;

      if (this.search) {
        const s = this.search.toLowerCase();
        result = result.filter(r =>
          r.seriesTitle.toLowerCase().includes(s) ||
          r.path.toLowerCase().includes(s) ||
          r.id.includes(s) ||
          r.types.toLowerCase().includes(s) ||
          r.topic.toLowerCase().includes(s) ||
          r.classes.toLowerCase().includes(s)
        );
      }
      if (this.filters.kinds.length)
        result = result.filter(r => this.filters.kinds.includes(r.kind));
      if (this.filters.levels.length)
        result = result.filter(r => this.filters.levels.includes(r.level));
      if (this.filters.difficulties.length)
        result = result.filter(r => this.filters.difficulties.includes(r.difficulty));
      if (this.filters.humanStatus)
        result = result.filter(r => r.humanStatus === this.filters.humanStatus);
      if (this.filters.llmStatus)
        result = result.filter(r => r.llmStatus === this.filters.llmStatus);
      if (this.filters.template)
        result = result.filter(r => r.types && r.types.split('|').map(t => t.trim()).includes(this.filters.template));

      if (this.filters.onePerTemplate) {
        const seen = new Set();
        result = result.filter(r => {
          if (r.kind === 'defi') return false;
          const key = (r.types || '') + '|' + r.kind;
          if (seen.has(key)) return false;
          seen.add(key);
          return true;
        });
      }

      return [...result].sort((a, b) => {
        let av = a[this.sort.col] ?? '';
        let bv = b[this.sort.col] ?? '';
        // Numeric sort for repeatTotal
        if (this.sort.col === 'repeatTotal') {
          av = Number(av); bv = Number(bv);
          return this.sort.dir === 'asc' ? av - bv : bv - av;
        }
        // Level ordering
        if (this.sort.col === 'level') {
          const order = ['CP','CE1','CE2','CM1','CM2'];
          av = order.indexOf(av); bv = order.indexOf(bv);
          return this.sort.dir === 'asc' ? av - bv : bv - av;
        }
        return this.sort.dir === 'asc'
          ? String(av).localeCompare(String(bv), 'fr')
          : String(bv).localeCompare(String(av), 'fr');
      });
    },

    sortBy(col) {
      if (this.sort.col === col) this.sort.dir = this.sort.dir === 'asc' ? 'desc' : 'asc';
      else { this.sort.col = col; this.sort.dir = 'asc'; }
    },

    toggleArr(key, val) {
      const arr = this.filters[key];
      const idx = arr.indexOf(val);
      if (idx === -1) arr.push(val); else arr.splice(idx, 1);
    },

    resetFilters() {
      this.search = '';
      this.filters = { kinds: [], levels: [], difficulties: [], humanStatus: '', llmStatus: '', template: '', onePerTemplate: false };
    },

    seriesUrl(row) {
      const folder = row.kind === 'application' ? 'applications'
                   : row.kind === 'defi' ? 'defis' : 'exercices';
      return `/fr/${folder}/${row.id}/`;
    },

    async copy(text) {
      try { await navigator.clipboard.writeText(text); } catch(_) {}
      this.copied = true;
      setTimeout(() => { this.copied = false; }, 1800);
    },
  };
}
</script>
