---
layout: base
---

<article class="prose dark:prose-invert max-w-none">
  <div class="mb-6">
    <a href="{{ '/fr/blog/' | url }}" class="not-prose !no-underline inline-flex items-center gap-2 rounded-full border border-primary-200 dark:border-primary-800 bg-primary-50 dark:bg-primary-900/30 py-1.5 pl-1.5 pr-4 text-sm font-semibold text-primary-700 dark:text-primary-300 hover:border-primary-500 hover:bg-primary-100 dark:hover:bg-primary-900/50 transition-colors">
      <span aria-hidden="true" class="flex h-7 w-7 items-center justify-center rounded-full bg-primary-500 text-white">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"/>
        </svg>
      </span>
      <span>Tous les articles</span>
    </a>
  </div>
  <h1>{{ title }}</h1>
  {% if date %}
  <p class="text-sm text-content-subtle">{{ date | date }}</p>
  {% endif %}
  {{ content | safe }}
</article>
