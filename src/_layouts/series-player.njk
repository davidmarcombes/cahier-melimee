---
layout: base
needsPocketBase: true
---

{#
  Series Player — Single-template engine.
  One set of HTML elements; Alpine.js swaps content dynamically from a JSON payload.
  Type-specific blocks are conditionally included at build time to keep pages minimal.
#}

{% set exercises = collections[folder or "exercices"] | seriesExercises(series) %}
{% set usedTypes = exercises | extractTypes %}
{% set hasGenerators = false %}
{% for ex in exercises %}{% if ex.data.generator %}{% set hasGenerators = true %}{% endif %}{% endfor %}

{% if hasGenerators %}
<script src="{{ '/assets/js/generators.js' | url }}"></script>
{% endif %}

{% if 'base-10' in usedTypes %}{% include "svg-defs.njk" %}{% endif %}

<div
  x-data='seriesPlayer({{ exercises | seriesPayload | safe }})'
  @hashchange.window="syncFromHash()" @resize.window.debounce="updateMatchLines()"
  x-cloak class="max-w-xl mx-auto py-8"
>
  {# Series header #}
  <div class="flex items-center justify-between mb-4 text-sm">
    <a href="{{ '/fr/exercices/' | url }}" class="text-slate-400 hover:text-primary-500 transition-colors text-lg" aria-label="Retour aux exercices">&#x2B05;&#xFE0F;</a>
    <span class="text-slate-400" x-text="(currentIndex + 1) + ' / ' + exercises.length"></span>
  </div>

  {# Progress bar #}
  <div class="w-full h-1.5 bg-slate-100 dark:bg-slate-800 rounded-full mb-6 overflow-hidden">
    <div class="h-full bg-primary-500 rounded-full transition-all duration-500"
         :style="'width:' + Math.round((solvedCount / exercises.length) * 100) + '%'"></div>
  </div>

  {# Test mode banner #}
  <div x-show="testMode"
       class="mb-4 flex items-center justify-between px-4 py-2 rounded-xl
              bg-amber-100 dark:bg-amber-900/30 border border-amber-300 dark:border-amber-700
              text-amber-800 dark:text-amber-300 text-sm font-medium">
    <span>🔍 Mode test</span>
    <button @click="showValidationPanel = true"
            class="px-3 py-1 rounded-lg bg-amber-200 dark:bg-amber-800 hover:bg-amber-300 dark:hover:bg-amber-700 transition-colors text-xs font-semibold">
      Valider la série
    </button>
  </div>

  {# Exercise title #}
  <h1 class="text-2xl font-bold text-content-default mb-4 text-center" x-text="cur.title"></h1>

  {# Type-specific visual blocks (only included when the series uses that type) #}
  {% if 'number-check' in usedTypes %}{% include "types/number-check.njk" %}{% endif %}
  {% if 'problem' in usedTypes %}{% include "types/problem.njk" %}{% endif %}
  {% if 'matching' in usedTypes %}{% include "types/matching.njk" %}{% endif %}
  {% if 'sequence' in usedTypes %}{% include "types/sequence.njk" %}{% endif %}
  {% if 'bounding' in usedTypes %}{% include "types/bounding.njk" %}{% endif %}
  {% if 'convert' in usedTypes %}{% include "types/convert.njk" %}{% endif %}
  {% if 'logic-grid' in usedTypes %}{% include "types/logic-grid.njk" %}{% endif %}
  {% if 'pyramid' in usedTypes %}{% include "types/pyramid.njk" %}{% endif %}
  {% if 'true-false' in usedTypes %}{% include "types/true-false.njk" %}{% endif %}
  {% if 'compare' in usedTypes %}{% include "types/compare.njk" %}{% endif %}
  {% if 'multi-question' in usedTypes %}{% include "types/multi-question.njk" %}{% endif %}
  {% if 'mcq' in usedTypes %}{% include "types/mcq.njk" %}{% endif %}
  {% if 'clock' in usedTypes %}{% include "types/clock.njk" %}{% endif %}
  {% if 'fraction' in usedTypes %}{% include "types/fraction.njk" %}{% endif %}
  {% if 'base-10' in usedTypes %}{% include "types/base-10.njk" %}{% endif %}
  {% if 'ruler' in usedTypes %}{% include "types/ruler.njk" %}{% endif %}

  {# Test mode — per-exercise flag #}
  <div x-show="testMode" class="flex justify-end mt-3 mb-2">
    <button @click="toggleFlag(currentIndex)"
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border text-xs font-medium transition-all"
            :class="exerciseFlags[currentIndex]
              ? 'border-red-400 bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-300'
              : 'border-slate-200 dark:border-slate-700 text-slate-500 hover:border-red-300 hover:text-red-500'">
      <span x-text="exerciseFlags[currentIndex] ? '⚠️ Problème signalé' : '✓ OK'"></span>
    </button>
  </div>

  {# Shared verify button for sequence/bounding/convert #}
  {% if 'sequence' in usedTypes or 'bounding' in usedTypes or 'convert' in usedTypes %}
    {% include "types/seq-verify.njk" %}
  {% endif %}

  {# Answer input + check button (for number-check, problem, clock, fraction and base-10) #}
  {% if 'number-check' in usedTypes or 'problem' in usedTypes or 'clock' in usedTypes or 'fraction' in usedTypes or 'base-10' in usedTypes or 'ruler' in usedTypes %}
  <div x-show="(cur.type === 'number-check' || cur.type === 'problem' || cur.type === 'clock' || cur.type === 'fraction' || cur.type === 'base-10' || cur.type === 'ruler') && !(cur.operation && cur.operation.includes('?'))" class="flex items-center gap-3 mb-6">
    <input
      type="text"
      x-model="userInput"
      @keydown.enter="check()"
      :disabled="solved"
      placeholder="Ta réponse…"
      x-ref="input"
      class="w-full px-4 py-3 text-lg border-2 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 transition-colors
        bg-surface-subtle text-content-default
        border-slate-200 dark:border-slate-700"
      :class="{
        'border-green-500 bg-green-50 dark:bg-green-900/20': solved,
        'border-red-400 bg-red-50 dark:bg-red-900/20': showError
      }"
    />
    <button
      @click="check()"
      :disabled="solved || !userInput.trim()"
      class="shrink-0 px-6 py-3 text-lg font-bold rounded-xl transition-all active:scale-95
        disabled:opacity-40 disabled:cursor-not-allowed"
      :class="solved
        ? 'bg-green-500 text-white'
        : 'bg-primary-500 text-white hover:bg-primary-600 shadow-md'"
    >
      <span x-show="!solved">Vérifier</span>
      <span x-show="solved">Bravo !</span>
    </button>
  </div>
  {% endif %}

  {# Error feedback #}
  <div
    x-show="showError"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    class="p-4 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-300"
  >
    {% if 'matching' in usedTypes %}
    <span x-show="cur.type === 'matching' && matchConnections.length < (cur.pairs ? cur.pairs.left.length : 0)">Relie tous les éléments avant de vérifier !</span>
    <span x-show="cur.type === 'matching' && matchConnections.length >= (cur.pairs ? cur.pairs.left.length : 0)">Certaines liaisons sont incorrectes. Essaie encore !</span>
    {% endif %}
    {% if 'sequence' in usedTypes or 'bounding' in usedTypes or 'convert' in usedTypes %}
    <span x-show="cur.type === 'sequence' || cur.type === 'bounding' || cur.type === 'convert'">Certains nombres ne sont pas corrects. Essaie encore !</span>
    {% endif %}
    {% if 'logic-grid' in usedTypes %}
    <span x-show="cur.type === 'logic-grid'">Certaines cases ne sont pas correctes. Essaie encore !</span>
    {% endif %}
    {% if 'pyramid' in usedTypes %}
    <span x-show="cur.type === 'pyramid'">Certains nombres ne sont pas corrects. Essaie encore !</span>
    {% endif %}
    {% if 'true-false' in usedTypes %}
    <span x-show="cur.type === 'true-false'">Certaines réponses ne sont pas correctes. Essaie encore !</span>
    {% endif %}
    {% if 'compare' in usedTypes %}
    <span x-show="cur.type === 'compare'">Certains signes ne sont pas corrects. Essaie encore !</span>
    {% endif %}
    {% if 'number-check' in usedTypes or 'problem' in usedTypes or 'clock' in usedTypes or 'fraction' in usedTypes or 'base-10' in usedTypes or 'ruler' in usedTypes %}
    <span x-show="cur.type === 'number-check' || cur.type === 'problem' || cur.type === 'clock' || cur.type === 'fraction' || cur.type === 'base-10' || cur.type === 'ruler'">Ce n'est pas la bonne réponse. Essaie encore !</span>
    {% endif %}
  </div>

  {# Success feedback #}
  <div
    x-show="solved"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 scale-95"
    x-transition:enter-end="opacity-100 scale-100"
    class="p-4 rounded-xl bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-700 dark:text-green-300 text-center"
  >
    Bonne réponse !
  </div>

  {# Series complete #}
  <div
    x-show="allSolved"
    x-transition:enter="transition ease-out duration-500"
    x-transition:enter-start="opacity-0 translate-y-4"
    x-transition:enter-end="opacity-100 translate-y-0"
    class="mt-6 text-center"
  >
    <div class="p-6 rounded-2xl bg-primary-50 dark:bg-primary-900/20 border border-primary-200 dark:border-primary-800">
      <p class="text-lg font-bold text-primary-700 dark:text-primary-300 mb-3">Série terminée !</p>
      <div class="flex gap-3 justify-center">
        <button x-show="hasGenerators" @click="regenerateAll(); goTo(0)"
          class="px-6 py-2 bg-primary-500 text-white rounded-xl hover:bg-primary-600 transition-all active:scale-95">
          Recommencer
        </button>
        <a href="{{ '/fr/exercices/' | url }}" class="px-6 py-2 border border-slate-300 dark:border-slate-600 text-content-default rounded-xl hover:bg-surface-subtle transition-all">
          Retour aux exercices
        </a>
      </div>
    </div>
  </div>

  {# Test mode — validation panel #}
  <div x-show="testMode && showValidationPanel"
       x-transition
       class="mt-6 p-5 rounded-2xl border-2 border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-amber-900/20 space-y-4">

    <h2 class="font-bold text-amber-900 dark:text-amber-200 text-lg">Validation de la série</h2>

    <div x-show="exerciseFlags.some(f => f)"
         class="text-sm text-red-700 dark:text-red-300 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl px-4 py-2">
      <span x-text="exerciseFlags.filter(Boolean).length + ' exercice(s) signalé(s) : '"></span>
      <template x-for="(flag, i) in exerciseFlags" :key="i">
        <span x-show="flag" class="font-mono mr-1" x-text="'#' + (i + 1)"></span>
      </template>
    </div>
    <div x-show="!exerciseFlags.some(f => f)"
         class="text-sm text-green-700 dark:text-green-300">
      ✓ Aucun exercice signalé
    </div>

    <div class="space-y-3" x-show="!testSent">
      <input type="text"
             x-model="testerName"
             placeholder="Votre nom ou e-mail *"
             class="w-full px-4 py-2 text-sm border-2 rounded-xl focus:outline-none focus:ring-2 focus:ring-amber-400
                    bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-700 text-content-default" />
      <textarea x-model="testNotes"
                placeholder="Notes (optionnel)…"
                rows="3"
                class="w-full px-4 py-2 text-sm border-2 rounded-xl focus:outline-none focus:ring-2 focus:ring-amber-400 resize-none
                       bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-700 text-content-default"></textarea>
      <button @click="submitValidation()"
              :disabled="!testerName.trim() || testSending"
              class="w-full py-2.5 rounded-xl font-bold text-sm transition-all active:scale-95
                     bg-amber-500 text-white hover:bg-amber-600 disabled:opacity-40 disabled:cursor-not-allowed">
        <span x-show="!testSending">Envoyer la validation</span>
        <span x-show="testSending">Envoi…</span>
      </button>
      <p x-show="testError" x-text="testError"
         class="text-red-600 dark:text-red-400 text-sm text-center"></p>
    </div>

    <div x-show="testSent"
         class="text-green-700 dark:text-green-300 text-center font-semibold text-sm">
      ✅ Validation envoyée !
    </div>
  </div>

  {% include "components/report-form.njk" %}
</div>
