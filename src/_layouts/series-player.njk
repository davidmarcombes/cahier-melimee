---
layout: base
isSeriesPage: true
---

{#
  Series Player — Single-template engine.
  One set of HTML elements; Alpine.js swaps content dynamically from a JSON payload.
  Type-specific blocks are conditionally included at build time to keep pages minimal.
#}
{% set exercises = collections[folder or "exercices"] | seriesExercises(series) %}
{% set usedTypes = exercises | extractTypes %}
{% set hasGenerators = false %}
{% set needsSvgJs = false %}
{% for ex in exercises %}
  {% if ex.data.generator or ex.data.type === 'base-10' %}{% set hasGenerators = true %}{% endif %}
  {% if ex.data.generator %}{% set needsSvgJs = true %}{% endif %}
  {% if ex.data.svg %}{% set needsSvgJs = true %}{% endif %}
  {% if ex.data.type === 'ruler' or ex.data.type === 'thermometer' or ex.data.type === 'number-line' or ex.data.type === 'coordinate-grid' or ex.data.type === 'svg-tiles' or ex.data.type === 'fraction' %}{% set needsSvgJs = true %}{% endif %}
{% endfor %}

{% if needsSvgJs %}
<script src="{{ '/assets/js/svg.js' | url }}"></script>
{% endif %}
{% if site.devMode %}
<script src="{{ '/assets/js/dev.js' | url }}"></script>
{% endif %}
{% if hasGenerators %}
<script src="{{ '/assets/js/generators.js' | url }}"></script>
{% endif %}


<script id="series-meta" type="application/json">{"id":"{{ id }}","url":"{{ page.url }}"}</script>

<div
  x-data='seriesPlayer({{ exercises | seriesPayload | safe }}, "{{ id }}")'
  @hashchange.window="syncFromHash()" @resize.window.debounce="updateMatchLines()"
  x-cloak class="max-w-xl mx-auto py-8"
>
  {# Series header #}
  <div class="flex items-center justify-between mb-4 text-sm">
    <a href="{{ '/fr/exercices/' | url }}" class="text-slate-400 hover:text-primary-500 transition-colors" aria-label="Retour au menu des exercices"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></a>
    <span class="text-slate-400" x-text="(currentIndex + 1) + ' / ' + exercises.length"></span>
  </div>

  {# Progress bar #}
  <div class="w-full h-1.5 bg-slate-100 dark:bg-slate-800 rounded-full mb-6 overflow-hidden">
    <div class="h-full bg-primary-500 rounded-full transition-all duration-500"
         :style="'width:' + Math.round((solvedCount / exercises.length) * 100) + '%'"></div>
  </div>

  {# Exercise content — hidden until init() completes (prevents hydration flicker) #}
  <div x-show="_ready">

  {# Exercise title #}
  <h1 class="exercise-title text-2xl font-bold text-content-default mb-4 text-center" x-html="cur.title || ''"></h1>

  {# Type-specific visual blocks (only included when the series uses that type) #}
  {% if 'number-check' in usedTypes %}{% include "types/number-check.njk" %}{% endif %}
  {% if 'problem' in usedTypes %}{% include "types/problem.njk" %}{% endif %}
  {% if 'matching' in usedTypes %}{% include "types/matching.njk" %}{% endif %}
  {% if 'sequence' in usedTypes %}{% include "types/sequence.njk" %}{% endif %}
  {% if 'bounding' in usedTypes %}{% include "types/bounding.njk" %}{% endif %}
  {% if 'convert' in usedTypes %}{% include "types/convert.njk" %}{% endif %}
  {% if 'logic-grid' in usedTypes %}{% include "types/logic-grid.njk" %}{% endif %}
  {% if 'pyramid' in usedTypes %}{% include "types/pyramid.njk" %}{% endif %}
  {% if 'true-false' in usedTypes %}{% include "types/true-false.njk" %}{% endif %}
  {% if 'compare' in usedTypes %}{% include "types/compare.njk" %}{% endif %}
  {% if 'compare-expressions' in usedTypes %}{% include "types/compare-expressions.njk" %}{% endif %}
  {% if 'estimation' in usedTypes %}{% include "types/estimation.njk" %}{% endif %}
  {% if 'error-analysis' in usedTypes %}{% include "types/error-analysis.njk" %}{% endif %}
  {% if 'compare-solutions' in usedTypes %}{% include "types/compare-solutions.njk" %}{% endif %}
  {% if 'multi-question' in usedTypes %}{% include "types/multi-question.njk" %}{% endif %}
  {% if 'mcq' in usedTypes %}{% include "types/mcq.njk" %}{% endif %}
  {% if 'clock' in usedTypes %}{% include "types/clock.njk" %}{% endif %}
  {% if 'column-op' in usedTypes %}{% include "types/column-op.njk" %}{% endif %}
  {% if 'fraction' in usedTypes %}{% include "types/fraction.njk" %}{% endif %}
  {% if 'base-10' in usedTypes %}{% include "types/base-10.njk" %}{% endif %}
  {% if 'ruler' in usedTypes %}{% include "types/ruler.njk" %}{% endif %}
  {% if 'thermometer' in usedTypes %}{% include "types/thermometer.njk" %}{% endif %}
  {% if 'fraction-check' in usedTypes %}{% include "types/fraction-check.njk" %}{% endif %}
  {% if 'fraction-paint' in usedTypes %}{% include "types/fraction-paint.njk" %}{% endif %}
  {% if 'tile-select' in usedTypes %}{% include "types/tile-select.njk" %}{% endif %}
  {% if 'sort' in usedTypes %}{% include "types/sort.njk" %}{% endif %}
  {% if 'drag-sort' in usedTypes %}{% include "types/drag-sort.njk" %}{% endif %}
  {% if 'fill-table' in usedTypes %}{% include "types/fill-table.njk" %}{% endif %}
  {% if 'click-blocks' in usedTypes %}{% include "types/click-blocks.njk" %}{% endif %}
  {% if 'checkbox' in usedTypes %}{% include "types/checkbox.njk" %}{% endif %}
  {% if 'select' in usedTypes %}{% include "types/select.njk" %}{% endif %}
  {% if 'svg-tiles' in usedTypes %}{% include "types/svg-tiles.njk" %}{% endif %}
  {% if 'number-hunt' in usedTypes %}{% include "types/number-hunt.njk" %}{% endif %}
  {% if 'compare-groups' in usedTypes %}{% include "types/compare-groups.njk" %}{% endif %}
  {% if 'count-objects' in usedTypes %}{% include "types/count-objects.njk" %}{% endif %}
  {% if 'number-line' in usedTypes %}{% include "types/number-line.njk" %}{% endif %}
  {% if 'coordinate-grid' in usedTypes %}{% include "types/coordinate-grid.njk" %}{% endif %}
  {% if 'bar-chart' in usedTypes %}{% include "types/bar-chart.njk" %}{% endif %}
  {% if 'calc-chain' in usedTypes %}{% include "types/calc-chain.njk" %}{% endif %}
  {% if 'magic-color' in usedTypes %}{% include "types/magic-color.njk" %}{% endif %}
  {% if 'inverse-problem' in usedTypes %}{% include "types/inverse-problem.njk" %}{% endif %}
  {% if 'tri-arith' in usedTypes %}{% include "types/tri-arith.njk" %}{% endif %}
  {% if 'decimal-triple' in usedTypes %}{% include "types/decimal-triple.njk" %}{% endif %}
  {% if 'decomp' in usedTypes %}{% include "types/decomp.njk" %}{% endif %}
  {% if 'function-machine' in usedTypes %}{% include "types/function-machine.njk" %}{% endif %}
  {% if 'maze' in usedTypes %}{% include "types/maze.njk" %}{% endif %}
  {% if 'venn' in usedTypes %}{% include "types/venn.njk" %}{% endif %}

  {# Shared verify button for sequence/bounding/convert #}
  {% if 'sequence' in usedTypes or 'bounding' in usedTypes or 'convert' in usedTypes %}
    {% include "types/seq-verify.njk" %}
  {% endif %}

  {# Answer input + check button (for number-check, problem, clock, fraction and base-10) #}
  {% if 'number-check' in usedTypes or 'problem' in usedTypes or 'clock' in usedTypes or 'fraction' in usedTypes or 'base-10' in usedTypes or 'ruler' in usedTypes or 'thermometer' in usedTypes or 'number-line' in usedTypes %}
  <div x-show="(cur.type === 'number-check' || cur.type === 'problem' || cur.type === 'clock' || cur.type === 'fraction' || cur.type === 'base-10' || cur.type === 'ruler' || cur.type === 'thermometer' || (cur.type === 'number-line' && cur.nl && cur.nl.mode !== 'place')) && !(cur.operation && cur.operation.includes('?'))" class="flex items-center gap-3 mb-6" :class="cur.type === 'clock' || cur.type === 'fraction' || cur.type === 'base-10' || cur.type === 'ruler' || cur.type === 'thermometer' || cur.type === 'number-line' ? 'justify-center' : ''"  >
    <input
      type="text"
      x-model="userInput"
      @keydown.enter="check()"
      :disabled="solved"
      :placeholder="cur.type === 'clock' ? 'hh:mm' : cur.type === 'fraction' ? 'a / b' : cur.type === 'base-10' ? 'Réponse' : cur.type === 'ruler' || cur.type === 'thermometer' || cur.type === 'number-line' ? '0,0' : 'Ta réponse…'"
      aria-label="Ta réponse"
      x-ref="input"
      class="px-4 py-3 text-lg border-2 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 transition-colors
        bg-surface-subtle text-content-default
        border-slate-200 dark:border-slate-700"
      :class="{
        'w-32': cur.type === 'clock' || cur.type === 'fraction' || cur.type === 'base-10' || cur.type === 'ruler' || cur.type === 'thermometer' || cur.type === 'number-line',
        'w-full': cur.type !== 'clock' && cur.type !== 'fraction' && cur.type !== 'base-10' && cur.type !== 'ruler' && cur.type !== 'thermometer' && cur.type !== 'number-line',
        'border-green-500 bg-green-50 dark:bg-green-900/20': solved,
        'border-red-400 bg-red-50 dark:bg-red-900/20': showError
      }"
    />
    <button
      type="button"
      @click="check()"
      :disabled="solved || !userInput.trim()"
      class="shrink-0 px-6 py-3 text-lg font-bold rounded-xl transition-all active:scale-95
        disabled:opacity-40 disabled:cursor-not-allowed"
      :class="solved
        ? 'bg-green-500 text-white'
        : 'bg-primary-500 text-white hover:bg-primary-600 shadow-md'"
    >
      <span x-show="!solved">Vérifier</span>
      <span x-show="solved">Bravo !</span>
    </button>
  </div>
  {% endif %}

  {# Error feedback #}
  <div
    x-show="showError"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    class="mt-4 p-4 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-300"
  >
    {% if 'matching' in usedTypes %}
    <span x-show="cur.type === 'matching' && matchConnections.length < (cur.pairs ? cur.pairs.left.length : 0)">Relie tous les éléments avant de vérifier !</span>
    <span x-show="cur.type === 'matching' && matchConnections.length >= (cur.pairs ? cur.pairs.left.length : 0)">Certaines liaisons sont incorrectes. Essaie encore !</span>
    {% endif %}
    {% if 'sequence' in usedTypes or 'bounding' in usedTypes or 'convert' in usedTypes %}
    <span x-show="cur.type === 'sequence' || cur.type === 'bounding' || cur.type === 'convert'">Certains nombres ne sont pas corrects. Essaie encore !</span>
    {% endif %}
    {% if 'logic-grid' in usedTypes %}
    <span x-show="cur.type === 'logic-grid'">Certaines cases ne sont pas correctes. Essaie encore !</span>
    {% endif %}
    {% if 'pyramid' in usedTypes %}
    <span x-show="cur.type === 'pyramid'">Certains nombres ne sont pas corrects. Essaie encore !</span>
    {% endif %}
    {% if 'true-false' in usedTypes %}
    <span x-show="cur.type === 'true-false'">Certaines réponses ne sont pas correctes. Essaie encore !</span>
    {% endif %}
    {% if 'compare' in usedTypes %}
    <span x-show="cur.type === 'compare'">Certains signes ne sont pas corrects. Essaie encore !</span>
    {% endif %}
    {% if 'compare-expressions' in usedTypes %}
    <span x-show="cur.type === 'compare-expressions'">Certains signes ne sont pas corrects. Essaie encore !</span>
    {% endif %}
    {% if 'estimation' in usedTypes %}
    <span x-show="cur.type === 'estimation'">Au moins une réponse n'est pas correcte. Essaie encore !</span>
    {% endif %}
    {% if 'number-check' in usedTypes or 'problem' in usedTypes or 'clock' in usedTypes or 'fraction' in usedTypes or 'base-10' in usedTypes or 'ruler' in usedTypes or 'thermometer' in usedTypes %}
    <span x-show="cur.type === 'number-check' || cur.type === 'problem' || cur.type === 'clock' || cur.type === 'fraction' || cur.type === 'base-10' || cur.type === 'ruler' || cur.type === 'thermometer'">Ce n'est pas la bonne réponse. Essaie encore !</span>
    {% endif %}
    {% if 'number-line' in usedTypes %}
    <span x-show="cur.type === 'number-line'">Ce n'est pas la bonne réponse. Essaie encore !</span>
    {% endif %}
    {% if 'fraction-check' in usedTypes %}
    <span x-show="cur.type === 'fraction-check'">Ce n'est pas la bonne fraction. Essaie encore !</span>
    {% endif %}
    {% if 'fraction-paint' in usedTypes %}
    <span x-show="cur.type === 'fraction-paint'">Ce n'est pas le bon nombre de cases. Essaie encore !</span>
    {% endif %}
    {% if 'tile-select' in usedTypes %}
    <span x-show="cur.type === 'tile-select'">Certaines tuiles ne sont pas correctes. Essaie encore !</span>
    {% endif %}
    {% if 'sort' in usedTypes %}
    <span x-show="cur.type === 'sort'">L'ordre n'est pas correct. Essaie encore !</span>
    {% endif %}
    {% if 'drag-sort' in usedTypes %}
    <span x-show="cur.type === 'drag-sort'">L'ordre n'est pas correct. Essaie encore !</span>
    {% endif %}
    {% if 'fill-table' in usedTypes %}
    <span x-show="cur.type === 'fill-table'">Certaines cases ne sont pas correctes. Essaie encore !</span>
    {% endif %}
    {% if 'click-blocks' in usedTypes %}
    <span x-show="cur.type === 'click-blocks'">Certaines colonnes ne sont pas correctes. Essaie encore !</span>
    {% endif %}
    {% if 'checkbox' in usedTypes %}
    <span x-show="cur.type === 'checkbox'">Certaines cases cochées ne sont pas correctes. Essaie encore !</span>
    {% endif %}
    {% if 'select' in usedTypes %}
    <span x-show="cur.type === 'select'">Certaines réponses ne sont pas correctes. Essaie encore !</span>
    {% endif %}
    {% if 'svg-tiles' in usedTypes %}
    <span x-show="cur.type === 'svg-tiles'">Certaines formes ne sont pas correctes. Essaie encore !</span>
    {% endif %}
    {% if 'coordinate-grid' in usedTypes %}
    <span x-show="cur.type === 'coordinate-grid'">Ce n'est pas le bon point. Essaie encore !</span>
    {% endif %}
    {% if 'bar-chart' in usedTypes %}
    <span x-show="cur.type === 'bar-chart'">Certaines barres ne sont pas correctes. Essaie encore !</span>
    {% endif %}
    {% if 'calc-chain' in usedTypes %}
    <span x-show="cur.type === 'calc-chain'">Certains résultats ne sont pas corrects. Essaie encore !</span>
    {% endif %}
    {% if 'magic-color' in usedTypes %}
    <span x-show="cur.type === 'magic-color'">Certaines cases ne sont pas de la bonne couleur. Essaie encore !</span>
    {% endif %}
    {% if 'inverse-problem' in usedTypes %}
    <span x-show="cur.type === 'inverse-problem'">Cette réponse n'est pas correcte. Essaie encore !</span>
    {% endif %}
    {% if 'error-analysis' in usedTypes %}
    <span x-show="cur.type === 'error-analysis'">L'étape ou la correction n'est pas correcte. Essaie encore !</span>
    {% endif %}
    {% if 'compare-solutions' in usedTypes %}
    <span x-show="cur.type === 'compare-solutions'">Ce n'est pas la bonne solution. Essaie encore !</span>
    {% endif %}
    {% if 'decimal-triple' in usedTypes %}
    <span x-show="cur.type === 'decimal-triple'">Certaines valeurs ne sont pas correctes. Essaie encore !</span>
    {% endif %}
    {% if 'decomp' in usedTypes %}
    <span x-show="cur.type === 'decomp'">Certaines valeurs ne sont pas correctes. Essaie encore !</span>
    {% endif %}
    {% if 'function-machine' in usedTypes %}
    <span x-show="cur.type === 'function-machine'">Ce n'est pas la bonne réponse. Essaie encore !</span>
    {% endif %}
    {% if 'maze' in usedTypes %}
    <span x-show="cur.type === 'maze'">Le chemin n'est pas correct. Essaie encore !</span>
    {% endif %}
    {% if 'venn' in usedTypes %}
    <span x-show="cur.type === 'venn'">Certains éléments ne sont pas bien placés. Essaie encore !</span>
    {% endif %}
    {% if 'tri-arith' in usedTypes %}
    <span x-show="cur.type === 'tri-arith'">Certains nombres ne sont pas corrects. Essaie encore !</span>
    {% endif %}
  </div>

  {# Success feedback #}
  <div
    x-show="solved"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 scale-95"
    x-transition:enter-end="opacity-100 scale-100"
    class="mt-4 p-4 rounded-xl bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-700 dark:text-green-300 text-center"
  >
    Bonne réponse !
  </div>

  </div>{# end _ready guard #}

  {# Series complete modal #}
  <template x-if="allSolved">
    <div
      class="fixed inset-0 z-[60] flex items-center justify-center p-4"
      x-cloak
    >
      <div 
        x-initial
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm"
      ></div>
      
      <div
        x-show="allSolved"
        x-transition:enter="transition ease-out duration-500 cubic-bezier(0.34, 1.56, 0.64, 1)"
        x-transition:enter-start="opacity-0 scale-90 translate-y-8"
        x-transition:enter-end="opacity-100 scale-100 translate-y-0"
        class="relative w-full max-w-sm bg-surface-chrome border border-slate-200 dark:border-slate-700 rounded-3xl shadow-2xl p-8 text-center"
      >
        <div class="w-20 h-20 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>

        <h2 class="text-2xl font-black text-content-default mb-2">Série terminée !</h2>
        <p class="text-content-subtle mb-8">Bravo, tu as réussi tous les exercices de cette série.</p>
        
        <div class="flex flex-col gap-3">
          <button type="button" x-show="hasGenerators" @click="regenerateAll(); goTo(0)"
            class="w-full px-6 py-3 bg-primary-500 text-white font-bold rounded-2xl hover:bg-primary-600 transition-all active:scale-95 shadow-lg shadow-primary-500/20">
            Recommencer la série
          </button>
          {% if site.devMode %}
          <button type="button" x-show="!humanValidated" @click="humanValidate()"
            :disabled="humanValidating"
            class="w-full px-6 py-3 bg-green-500 text-white font-bold rounded-2xl hover:bg-green-600 transition-all active:scale-95 disabled:opacity-40">
            <span x-show="!humanValidating">✓ Valider la série</span>
            <span x-show="humanValidating">Envoi…</span>
          </button>
          <a x-show="nextUnvalidatedUrl" :href="nextUnvalidatedUrl || '#'"
            class="w-full px-6 py-3 bg-amber-500 text-white font-bold rounded-2xl hover:bg-amber-600 transition-all active:scale-95 text-center">
            <span x-show="!humanValidated">→ Suivante non validée</span>
            <span x-show="humanValidated">✓ Validée — Suivante →</span>
          </a>
          <p x-show="humanValidated && !nextUnvalidatedUrl" class="text-green-600 dark:text-green-400 text-sm text-center font-semibold">Toutes les séries sont validées !</p>
          {% endif %}
          <a href="{{ '/fr/exercices/' | url }}" class="w-full px-6 py-3 border-2 border-slate-200 dark:border-slate-700 text-content-default font-bold rounded-2xl hover:bg-surface-subtle transition-all text-center">
            Retour aux exercices
          </a>
        </div>
      </div>
    </div>
  </template>


  {% if site.devMode %}{% include "components/debug-panel.njk" %}{% endif %}
</div>
