<!doctype html>
<html lang="{{ lang or 'en' }}" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <title>{{ title or site.title }}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">

    <!-- Favicons & social images -->
    <link rel="icon" type="image/png" sizes="32x32" href="{{ '/favicon-32x32.png' | url }}">
    <link rel="icon" type="image/x-icon" sizes="16x16" href="{{ '/favicon.ico' | url }}">
    <link rel="apple-touch-icon" href="{{ '/apple-touch-icon.png' | url }}">
    <meta name="theme-color" content="#ffffff">

    <!-- Open Graph / Twitter -->
    <meta property="og:title" content="{{ title or site.title }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:image" content="{{ site.url }}/assets/images/share-image.jpg" />
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image" />


    <link rel="stylesheet" href="{{ '/css/styles.css' | url }}">
    <style>[x-cloak] { display: none !important; }</style>

    <!-- Path prefix for JS runtime fetches -->
    <script>window.__pathPrefix = '{{ '/' | url }}';</script>
    <!-- Dark mode initialization script — runs before styles so no flash of wrong theme on load -->
    <script>
      if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches))
      { document.documentElement.classList.add('dark'); }
    </script>

  </head>
  <body class="min-h-screen flex flex-col bg-surface-default text-content-default">
    {% include "components/header.njk" %}

    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 bg-white p-4 rounded-lg shadow-lg">Passer au contenu</a>
  
    <main id="main-content" class="flex-1 max-w-6xl mx-auto px-4 py-8 w-full">
      {{ content | safe }}
    </main>

    {% include "components/footer.njk" %}

    {% if needsPocketBase %}
    <!-- Demo mode indicator — shown when PocketBase is unavailable -->
    <div id="demo-banner" style="display:none"
      class="fixed bottom-4 right-4 px-3 py-1.5 text-xs font-bold rounded-full bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300 border border-amber-300 dark:border-amber-700 shadow-sm z-50">
      Mode démo
    </div>

    <!-- PocketBase SDK — deferred so it doesn't block parsing; runs before Alpine in document order -->
    <script defer src="https://unpkg.com/pocketbase@latest/dist/pocketbase.umd.js"></script>
    {% endif %}
    <script defer type="module" src="{{ '/assets/js/app.js' | url }}"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    {% if needsPocketBase %}
    <script>
      window.__pbUrl = '{{ pocketbase.url }}';
      /* Lazy: health check only fires on first call, result is cached */
      let __pbCheck;
      window.__pbAvailable = () => {
        if (!__pbCheck) {
          __pbCheck = (async () => {
            try {
              const c = new AbortController();
              setTimeout(() => c.abort(), 2000);
              const r = await fetch(window.__pbUrl + '/api/health', { signal: c.signal });
              return r.ok;
            } catch { return false; }
          })();
          __pbCheck.then(ok => {
            if (!ok) { const b = document.getElementById('demo-banner'); if (b) b.style.display = ''; }
          });
        }
        return __pbCheck;
      };
    </script>
    {% endif %}
  </body>
</html>
