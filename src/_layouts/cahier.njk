---
layout: base
needsPocketBase: true
---

<div x-data="cahierPage()" x-init="init()" x-cloak class="max-w-2xl mx-auto py-12 px-4">

  {# Loading #}
  <div x-show="state === 'loading'" class="text-center py-24 text-content-subtle">
    <div class="inline-block w-8 h-8 border-4 border-primary-300 border-t-primary-600 rounded-full animate-spin mb-4"></div>
    <p>Chargement de ton cahier…</p>
  </div>

  {# Not found / no user param #}
  <div x-show="state === 'notfound'" class="text-center py-16">
    <div class="text-6xl mb-6">🔍</div>
    <h1 class="text-2xl font-bold text-content-default mb-3">Cahier introuvable</h1>
    <p class="text-content-subtle mb-8">Ce lien ne correspond à aucun cahier enregistré.</p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="{{ '/fr/connexion/' | url }}" class="px-6 py-3 bg-primary-500 text-white font-bold rounded-xl hover:bg-primary-600 transition-all shadow-md">Se connecter</a>
      <a href="{{ '/fr/onboarding/' | url }}" class="px-6 py-3 border border-slate-300 dark:border-slate-600 text-content-default font-bold rounded-xl hover:bg-surface-subtle transition-all">Créer un cahier</a>
    </div>
  </div>

  {# Cahier content #}
  <div x-show="state === 'ready'">

    {# Header — identity card #}
    <div class="flex items-center gap-5 mb-10 p-6 bg-surface-subtle rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
      <div class="text-6xl leading-none" x-text="pupil.sticker_id"></div>
      <div>
        <h1 class="text-2xl font-extrabold text-content-default leading-tight" x-text="pupil?.username || 'Cahier personnel'">Cahier personnel</h1>
        <p class="text-sm text-content-subtle mt-1">Mon cahier personnel</p>
      </div>
      <div class="ml-auto">
        <button type="button" @click="logout()" class="text-xs px-3 py-1.5 border border-slate-300 dark:border-slate-600 rounded-lg text-content-subtle hover:text-content-default hover:bg-surface-subtle transition-all">
          Déconnexion
        </button>
      </div>
    </div>

    {# Share link #}
    <div class="mb-8 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-xl border border-blue-100 dark:border-blue-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <div>
        <p class="text-xs font-semibold text-blue-800 dark:text-blue-300 mb-0.5">Ton lien secret (marque-le !)</p>
        <code class="text-xs text-blue-600 dark:text-blue-400 font-mono break-all" x-text="shareUrl"></code>
      </div>
      <button type="button" @click="copyLink()" class="shrink-0 px-3 py-1.5 text-xs font-bold border border-blue-200 dark:border-blue-700 rounded-lg text-blue-700 dark:text-blue-300 hover:bg-blue-100 dark:hover:bg-slate-700 transition-all active:scale-95">
        <span x-show="!recentlyCopied">📋 Copier</span>
        <span x-show="recentlyCopied" class="text-green-600 dark:text-green-400">✅ Copié !</span>
      </button>
    </div>

    {# Quick access to exercises #}
    <div class="mb-8">
      <h2 class="text-lg font-bold text-content-default mb-4">Commencer à travailler</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a href="{{ '/fr/exercices/' | url }}" class="flex items-center gap-3 p-4 bg-surface-subtle rounded-xl border border-slate-200 dark:border-slate-700 hover:border-primary-400 hover:shadow-md transition-all group">
          <span class="text-3xl">📚</span>
          <div>
            <p class="font-bold text-content-default group-hover:text-primary-600 dark:group-hover:text-primary-400">Exercices</p>
            <p class="text-xs text-content-subtle">Toutes les séries disponibles</p>
          </div>
        </a>
        <a href="{{ '/fr/connexion/' | url }}" class="flex items-center gap-3 p-4 bg-surface-subtle rounded-xl border border-slate-200 dark:border-slate-700 hover:border-primary-400 hover:shadow-md transition-all group">
          <span class="text-3xl">🔑</span>
          <div>
            <p class="font-bold text-content-default group-hover:text-primary-600 dark:group-hover:text-primary-400">Changer de cahier</p>
            <p class="text-xs text-content-subtle">Se connecter avec un autre nom</p>
          </div>
        </a>
      </div>
    </div>

    {# Progress — from localStorage #}
    <div class="p-6 bg-surface-subtle rounded-2xl border border-slate-200 dark:border-slate-700">
      <h2 class="text-lg font-bold text-content-default mb-3">Mes progrès</h2>
      <template x-if="doneSeries.length === 0">
        <p class="text-sm text-content-subtle">Tu n'as pas encore terminé de série. Lance-toi !</p>
      </template>
      <template x-if="doneSeries.length > 0">
        <div>
          <p class="text-sm text-content-subtle mb-3">
            <span class="text-2xl font-extrabold text-primary-600 dark:text-primary-400" x-text="doneSeries.length"></span>
            <span x-text="doneSeries.length === 1 ? ' série terminée' : ' séries terminées'"></span>
          </p>
          <div class="flex flex-wrap gap-2">
            <template x-for="s in doneSeries.slice(0, 12)" :key="s.id">
              <a :href="(window.__pathPrefix || '/') + 'fr/exercices/' + s.id + '/'"
                 class="px-2.5 py-1 text-xs font-mono bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-400 border border-green-200 dark:border-green-800 rounded-lg hover:bg-green-100 transition-colors"
                 x-text="s.id"></a>
            </template>
            <span x-show="doneSeries.length > 12" class="px-2.5 py-1 text-xs text-content-subtle" x-text="'+ ' + (doneSeries.length - 12) + ' autres'"></span>
          </div>
        </div>
      </template>
    </div>

  </div>
</div>

<script>
function cahierPage() {
  const pb = new PocketBase(window.__pbUrl);

  return {
    state: 'loading',   // 'loading' | 'ready' | 'notfound'
    pupil: null,
    doneSeries: [],
    recentlyCopied: false,

    get shareUrl() {
      const prefix = window.__pathPrefix || '/';
      return window.location.origin + prefix + 'fr/cahier/?user=' + (this.pupil?.slug || '');
    },

    async init() {
      const params = new URLSearchParams(window.location.search);
      const slug = params.get('user');

      if (!slug) { this.state = 'notfound'; return; }

      // 1. Try localStorage first — instant, works fully offline
      const cached = localStore.getUser();
      if (cached && cached.slug === slug) {
        this.pupil = cached;
        this._loadProgress();
        this.state = 'ready';
        return;
      }

      // 2. Fall back to PocketBase
      const live = await window.__pbAvailable();
      if (!live) {
        // Still offline but no cache — reconstruct from slug
        const parts = slug.split('-');
        this.pupil = { username: parts.slice(0, -1).join('-'), sticker_id: '🎈', slug };
        this._loadProgress();
        this.state = 'ready';
        return;
      }

      try {
        const results = await pb.collection('pupils').getFullList({ filter: `slug = "${slug}"` });
        if (results.length === 0) { this.state = 'notfound'; return; }
        this.pupil = results[0];
        localStore.setUser(this.pupil);  // cache for next visit
        this._loadProgress();
        this.state = 'ready';
      } catch (err) {
        console.error('Cahier load error:', err);
        this.state = 'notfound';
      }
    },

    _loadProgress() {
      const progress = localStore.getProgress();
      this.doneSeries = Object.entries(progress)
        .filter(([, v]) => v.done)
        .sort((a, b) => (b[1].completedAt || '').localeCompare(a[1].completedAt || ''))
        .map(([id]) => ({ id }));
    },

    async copyLink() {
      try {
        await navigator.clipboard.writeText(this.shareUrl);
        this.recentlyCopied = true;
        setTimeout(() => this.recentlyCopied = false, 2000);
      } catch {}
    },

    logout() {
      localStore.clearUser();
      window.location.href = (window.__pathPrefix || '/') + 'fr/connexion/';
    }
  };
}
</script>
