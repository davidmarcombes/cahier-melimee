---
layout: base
---

{# Pick who is working. Cahiers live in this browser only (see modules/store.js); a file brings one from another device. #}
<div x-data="cahiersPage()" x-init="init()" x-cloak class="max-w-2xl mx-auto py-12 px-4">
  <h1 class="text-3xl font-extrabold text-content-default mb-8 text-center">{{ title }}</h1>

  <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-10">
    <template x-for="p in pupils" :key="p.slug">
      <button type="button" @click="open(p.slug)"
        class="flex flex-col items-center gap-2 p-5 bg-surface-subtle rounded-2xl border-2 transition-all hover:border-primary-400 hover:shadow-md active:scale-95"
        :class="p.slug === currentSlug ? 'border-primary-500' : 'border-slate-200 dark:border-slate-700'">
        <span class="text-5xl leading-none" x-text="p.sticker_id"></span>
        <span class="font-bold text-content-default text-center break-words" x-text="p.username"></span>
        <span class="text-xs text-content-subtle" x-text="p.done + (p.done > 1 ? ' séries' : ' série')"></span>
      </button>
    </template>
    <a href="{{ '/fr/onboarding/' | url }}"
       class="flex flex-col items-center justify-center gap-2 p-5 rounded-2xl border-2 border-dashed border-slate-300 dark:border-slate-600 text-content-subtle hover:border-primary-400 hover:text-primary-600 transition-all">
      <span class="text-4xl leading-none">＋</span>
      <span class="font-bold text-center">Nouveau cahier</span>
    </a>
  </div>

  <section id="importer" class="p-6 bg-surface-subtle rounded-2xl border border-slate-200 dark:border-slate-700">
    <h2 class="text-lg font-bold text-content-default mb-1">Reprendre un cahier enregistré</h2>
    <p class="text-sm text-content-subtle mb-4">Tu as sauvegardé ton cahier dans un fichier sur un autre appareil ? Ouvre-le ici.</p>
    <label class="inline-block px-5 py-2.5 bg-primary-500 text-white font-bold rounded-xl shadow-md hover:bg-primary-600 transition-all active:scale-95 cursor-pointer">
      Ouvrir un fichier
      <input type="file" accept=".json,application/json" class="sr-only" @change="importFile($event)">
    </label>
    <p x-show="error" class="mt-3 text-sm text-red-600 dark:text-red-400" x-text="error" role="alert"></p>
  </section>

  <p class="mt-8 text-xs text-center text-content-subtle">
    Pas de compte, pas d'e-mail : les cahiers sont enregistrés dans ce navigateur, sur cet appareil.
  </p>
</div>

<script>
function cahiersPage() {
  const cahierUrl = (slug) => (window.__pathPrefix || '/') + 'fr/cahier/?user=' + encodeURIComponent(slug);
  return {
    pupils: [],
    currentSlug: null,
    error: '',

    init() {
      this.pupils = localStore.listUsers();
      this.currentSlug = localStore.getUser()?.slug || null;
    },

    open(slug) {
      localStore.switchUser(slug);
      window.location.href = cahierUrl(slug);
    },

    async importFile(event) {
      this.error = '';
      const file = event.target.files && event.target.files[0];
      event.target.value = '';
      if (!file) return;
      try {
        if (file.size > 1_000_000) throw new Error("Ce fichier est trop gros pour être un cahier.");
        let data;
        try {
          data = JSON.parse(await file.text());
        } catch {
          throw new Error("Ce fichier n'est pas un cahier de Mélimée.");
        }
        const { slug } = localStore.importUser(data);
        window.location.href = cahierUrl(slug);
      } catch (e) {
        this.error = e.message;
      }
    },
  };
}
</script>
