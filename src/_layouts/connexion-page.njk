---
layout: base
---

<div class="max-w-md mx-auto py-12">
  <h1 class="text-3xl font-extrabold text-content-default mb-2 text-center">{{ title }}</h1>

  {{ content | safe }}

  <div x-data="connexionForm()" x-init="init()" x-cloak class="p-8 bg-surface-subtle rounded-2xl shadow-xl border border-slate-200 dark:border-slate-700">

    {# Found in localStorage #}
    <div x-show="state === 'found'" class="text-center py-4">
      <div class="text-6xl mb-4" x-text="pupil.sticker_id"></div>
      <h2 class="text-2xl font-bold text-content-default mb-2">Content de te revoir !</h2>
      <p class="text-content-subtle mb-6" x-text="pupil.username"></p>
      <a :href="(window.__pathPrefix || '/') + 'fr/cahier/?user=' + pupil.slug"
         class="inline-block px-8 py-3 bg-primary-500 text-white font-bold rounded-xl shadow-md hover:bg-primary-600 transition-all active:scale-95">
        Accéder à mon cahier
      </a>
      <div class="mt-6">
        <button type="button" @click="switchAccount()"
                class="text-sm text-content-subtle hover:text-content-default underline transition-colors">
          Ce n'est pas moi — changer de cahier
        </button>
      </div>
    </div>

    {# Not found — no local profile #}
    <div x-show="state === 'notfound'" class="text-center py-4">
      <div class="text-6xl mb-6">🔍</div>
      <p class="text-content-subtle mb-8">Aucun cahier enregistré sur cet appareil.</p>
      <a href="{{ '/fr/onboarding/' | url }}"
         class="inline-block px-8 py-3 bg-primary-500 text-white font-bold rounded-xl shadow-md hover:bg-primary-600 transition-all active:scale-95">
        Créer mon cahier
      </a>
    </div>

  </div>
</div>

<script>
function connexionForm() {
  return {
    state: 'notfound',
    pupil: null,

    init() {
      const user = localStore.getUser();
      if (user) {
        this.pupil = user;
        this.state = 'found';
      }
    },

    switchAccount() {
      localStore.clearUser();
      window.location.href = (window.__pathPrefix || '/') + 'fr/onboarding/';
    }
  };
}
</script>
